<% const landing=englishContent.landing; const targets=['english-goals','english-methods','english-plan','english-fees','english-gallery','english-faq']; %>
<main class="english-landing" data-english-landing>
  <section class="el-hero-panel">
    <div class="wrap">
      <nav class="crumbs" aria-label="<%= siteText('view.course-detail.001') %>"><a href="/khoa-hoc"><%= siteText('view.course-detail.005') %></a><span>›</span><span><%= course.name %></span></nav>
      <header class="el-hero">
        <div class="el-hero__copy">
          <span class="eyebrow"><%= englishContent.eyebrow %></span>
          <h1><%= course.name %></h1>
          <p class="el-hero__headline"><%= englishContent.headline %></p>
          <p class="el-hero__intro"><%= englishContent.intro %></p>
          <div class="english-actions"><a class="btn btn-primary" href="#lienhe"><%= englishContent.primaryLabel %> <span aria-hidden="true">↗</span></a><a class="btn btn-ghost" href="#english-methods"><%= englishContent.secondaryLabel %></a></div>
          <div class="el-hero__tags"><% englishContent.goals.forEach(function(goal){ %><a href="#english-goals"><span aria-hidden="true">✦</span> <%= goal.title %></a><% }); %></div>
        </div>
        <div class="el-hero__visual">
          <figure><img <%- imageAttributes(englishContent.heroImage,'(max-width: 900px) 100vw, 600px') %> alt="<%= englishContent.heroAlt %>" fetchpriority="high"><figcaption><%= englishContent.heroCaption %></figcaption></figure>
          <div class="el-hero__badge"><span class="el-hero__badge-icon" aria-hidden="true">✦</span><div><strong><%= landing.heroBadgeTitle %></strong><span><%= landing.heroBadgeText %></span></div></div>
        </div>
      </header>
    </div>
  </section>

  <div class="el-benefits"><div class="wrap"><% landing.benefits.forEach(function(item){ %><div><span aria-hidden="true">✓</span><div><strong><%= item.title %></strong><p><%= item.text %></p></div></div><% }); %></div></div>

  <div class="el-nav-slot"><nav class="el-nav" aria-label="<%= landing.navLabel %>"><div class="wrap"><div class="el-nav__links"><% landing.navItems.forEach(function(label,index){ if(targets[index]){ %><a href="#<%= targets[index] %>"><%= label %></a><% }}); %></div><a class="btn btn-primary" href="#lienhe"><%= englishContent.primaryLabel %> <span aria-hidden="true">↗</span></a></div></nav></div>

  <section class="el-section" id="english-goals">
    <div class="wrap">
      <div class="el-section__head"><span class="eyebrow"><%= landing.goalsEyebrow %></span><h2><%= englishContent.goalsTitle %></h2><p><%= englishContent.goalsLead %></p></div>
      <div class="el-goals"><% englishContent.goals.forEach(function(goal,index){ %><article class="el-goal"><span class="el-goal__number" aria-hidden="true"><%= String(index+1).padStart(2,'0') %></span><h3><%= goal.title %></h3><p><%= goal.text %></p><a class="btn btn-ghost" href="#english-plan" data-english-goal="<%= index %>"><%= landing.goalButton %> <span aria-hidden="true">↗</span></a></article><% }); %></div>
    </div>
  </section>

  <section class="el-section el-methods" id="english-methods">
    <div class="wrap">
      <div class="el-section__head"><span class="eyebrow"><%= landing.methodsEyebrow %></span><h2><%= englishContent.methodsTitle %></h2><p><%= englishContent.methodsLead %></p></div>
      <div class="el-skills"><% const icons=['<path d="M4 14v-3a8 8 0 0 1 16 0v3M4 13h3v7H5a1 1 0 0 1-1-1zm16 0h-3v7h2a1 1 0 0 0 1-1z"/>','<path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8A8.5 8.5 0 0 1 8.7 4a8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.4Z"/>','<path d="M12 5v16M3 3h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5v16h-5a4 4 0 0 0-4 2 4 4 0 0 0-4-2H3Z"/>','<path d="m16 3 5 5-12 12-6 1 1-6Zm-2 2 5 5M3 21l5-1-4-4"/>']; %>
        <% englishContent.methods.forEach(function(item,index){ %><article><span class="el-skill-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><%- icons[index%icons.length] %></svg></span><h3><%= item.title %></h3><p><%= item.text %></p></article><% }); %>
      </div>
    </div>
  </section>

  <section class="el-section el-plan-section" id="english-plan">
    <div class="wrap el-plan-layout">
      <div class="el-section__head"><span class="eyebrow"><%= landing.planEyebrow %></span><h2><%= landing.planTitle %></h2><p><%= landing.planLead %></p><ol class="el-mini-steps"><% landing.steps.forEach(function(step,index){ %><li><span aria-hidden="true"><%= index+1 %></span><strong><%= step.title %></strong></li><% }); %></ol></div>
      <div class="el-plan-card">
        <div class="el-plan-controls"><div class="field"><label for="english-level"><%= landing.levelLabel %></label><select id="english-level"><% landing.levels.forEach(function(level){ %><option><%= level %></option><% }); %></select></div><div class="field"><label for="english-goal"><%= landing.goalLabel %></label><select id="english-goal"><% englishContent.goals.forEach(function(goal,index){ %><option value="<%= index %>"><%= goal.title %></option><% }); %></select></div></div>
        <div class="el-plan-result" aria-live="polite" aria-atomic="true"><span><%= landing.recommendationLabel %></span><h3 data-english-plan-title><%= englishContent.goals[0].title %></h3><p data-english-plan-text><%= englishContent.goals[0].text %></p></div>
        <p class="el-plan-note"><%= landing.planNote %></p><a class="btn btn-primary" href="#lienhe"><%= landing.planButton %> <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="el-section el-gallery-section" id="english-gallery"><div class="wrap"><div class="el-section__head"><span class="eyebrow"><%= landing.galleryEyebrow %></span><h2><%= englishContent.galleryTitle %></h2><p><%= englishContent.galleryLead %></p></div><div class="el-gallery"><% englishContent.gallery.forEach(function(photo){ %><figure><img <%- imageAttributes(photo.image,'(max-width: 600px) 100vw, (max-width: 900px) 50vw, 600px') %> alt="<%= photo.alt %>" loading="lazy" decoding="async"><figcaption><%= photo.caption %></figcaption></figure><% }); %></div></div></section>

  <section class="el-section el-enrolment"><div class="wrap"><div class="el-section__head"><h2><%= landing.stepsTitle %></h2></div><ol class="el-steps"><% landing.steps.forEach(function(step,index){ %><li><span class="el-step-number" aria-hidden="true"><%= String(index+1).padStart(2,'0') %></span><h3><%= step.title %></h3><p><%= step.text %></p></li><% }); %></ol></div></section>

  <section class="el-section el-fees" id="english-fees"><div class="wrap"><div class="el-section__head"><span class="eyebrow"><%= landing.feesEyebrow %></span><h2><%= landing.feesTitle %></h2><p><%= landing.feesLead %></p></div>
    <div class="el-course-summary"><h3><%= englishContent.detailsTitle %></h3><p><%= course.blufSummary %></p><div><span><%= siteText('view.course-detail.007') %></span><strong><%= course.price %></strong></div></div>
    <div class="el-course-information"><%- include('partials/course-information') %></div>
    <aside class="source-note"><strong><%= siteText('view.course-detail.051') %></strong> <%= courseNotice %></aside>
    <%- include('partials/content-responsibility',{item:course,kind:'course'}) %>
  </div></section>

  <section class="el-section el-faq" id="english-faq"><div class="wrap"><div class="el-section__head"><span class="eyebrow"><%= siteText('view.course-detail.044') %></span><h2><%= landing.faqTitle %></h2></div><div><% courseFaqs.forEach(function(faq,index){ %><details class="faq-item" <%= index===0?'open':'' %>><summary><%= faq.question %></summary><p class="section-lead"><%= faq.answer %></p></details><% }); %></div></div></section>

  <section class="el-section el-consult" id="lienhe"><div class="wrap el-consult-layout"><div class="el-consult__copy"><span class="eyebrow"><%= englishContent.consultationEyebrow %></span><h2><%= englishContent.consultationTitle %></h2><p><%= englishContent.consultationText %></p><div class="cta__contacts"><%- getBlock('consult-contact').content %></div></div>
    <form class="cta__form el-consult__form" id="consultationForm" data-lead-form>
      <h3><%= landing.formTitle %></h3><p class="el-form-lead"><%= landing.formLead %></p>
      <div class="field"><label for="ten"><%= getBlock('consult-label-name').title %></label><input id="ten" name="name" type="text" autocomplete="name" minlength="2" maxlength="100" required placeholder="<%= siteText('view.home-sections.consult.001') %>"></div>
      <div class="el-form-pair"><div class="field"><label for="sdt"><%= getBlock('consult-label-phone').title %></label><input id="sdt" name="phone" type="tel" inputmode="tel" autocomplete="tel" minlength="9" maxlength="20" required placeholder="<%= siteText('view.home-sections.consult.002') %>"></div><div class="field"><label for="email"><%= getBlock('consult-label-email').title %></label><input id="email" name="email" type="email" autocomplete="email" maxlength="180" required placeholder="<%= siteText('view.home-sections.consult.003') %>"></div></div>
      <input type="hidden" name="interest" value="<%= course.name %>"><input type="hidden" name="contextLocked" value="1">
      <div class="field"><label for="english-interest-detail"><%= landing.detailLabel %></label><textarea id="english-interest-detail" name="interestDetail" rows="3" maxlength="240" placeholder="<%= landing.detailPlaceholder %>"></textarea></div>
      <div class="field hp-field" aria-hidden="true"><label><%= siteText('view.home-sections.consult.010') %><input name="website" tabindex="-1" autocomplete="off"></label></div><input type="hidden" name="formStartedAt" value="">
      <button class="btn btn-primary" type="submit" data-lead-submit><%= getBlock('consult-label-submit').title %> <span aria-hidden="true">↗</span></button><p class="form-note" data-lead-status role="status" aria-live="polite"></p><div class="form-note"><%- getBlock('consult-consent').content %></div>
    </form>
  </div></section>
  <aside class="el-team"><div class="wrap"><span><%= landing.recruitmentLabel %></span><a href="<%= siteText('view.course-detail.049') %>"><%= siteText('view.course-detail.050') %> <span aria-hidden="true">↗</span></a></div></aside>
</main>
<script type="application/json" id="english-landing-data"><%- siteJson({goals:englishContent.goals,goalLabel:landing.goalLabel,levelLabel:landing.levelLabel}) %></script>
<script src="/js/english-landing.js?v=<%= assetVer %>" defer></script>
