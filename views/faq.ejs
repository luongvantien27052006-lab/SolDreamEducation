<main>
<section class="section knowledge-hub">
  <div class="wrap">
    <nav class="crumbs" aria-label="<%= siteText("view.faq.001") %>"><a href="<%= siteText("view.faq.002") %>"><%= siteText("view.faq.003") %></a> <span>›</span> <span><%= siteText("view.faq.004") %></span></nav>
    <header class="knowledge-hero">
      <span class="eyebrow"><%= siteText("view.faq.005") %></span>
      <h1><%= siteText("view.faq.006") %></h1>
      <p><%= siteText("view.faq.007") %></p>
      <div class="source-meta"><strong><%= siteText("view.faq.008") %></strong> <%= siteText("view.faq.009") %> <strong><%= siteText("view.faq.010") %></strong> <%= siteText("view.faq.011") %></div>
    </header>

    <nav class="faq-tabs" aria-label="<%= siteText("view.faq.012") %>">
      <% faqGroups.forEach(function(group, index){ %>
        <a href="#faq-nhom-<%= index + 1 %>"><%= group.category %><span><%= group.items.length %></span></a>
      <% }); %>
    </nav>

    <div class="faq-groups">
      <% faqGroups.forEach(function(group, groupIndex){ %>
      <section class="faq-group" id="faq-nhom-<%= groupIndex + 1 %>" aria-labelledby="faq-title-<%= groupIndex + 1 %>">
        <header><span class="eyebrow"><%= siteText("view.faq.013") %></span><h2 id="faq-title-<%= groupIndex + 1 %>"><%= group.category %></h2></header>
        <div class="faq-list" aria-label="<%= siteText('view.faq.category-aria',{v0:group.category}) %>">
          <% group.items.forEach(function(faq){ %>
          <details class="faq-item" id="cau-hoi-<%= faq.id %>">
            <summary><%= faq.question %></summary>
            <div class="faq-answer"><p><%= faq.answer %></p>
              <% if (faq.source_url) { %><a href="<%= faq.source_url %>" target="_blank" rel="noopener noreferrer"><%= siteText("view.faq.014") %></a><% } %>
            </div>
          </details>
          <% }); %>
        </div>
      </section>
      <% }); %>
    </div>

    <aside class="source-note"><strong><%= siteText("view.faq.015") %></strong> <%= siteText("view.faq.016") %></aside>
  </div>
</section>
</main>
