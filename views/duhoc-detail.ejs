<main>
<article class="section" style="padding-top:56px">
  <div class="wrap" style="max-width:820px">
    <nav class="crumbs" aria-label="<%= siteText("view.duhoc-detail.001") %>" style="font-size:14px;color:var(--muted);margin-bottom:16px">
      <a href="<%= siteText("view.duhoc-detail.002") %>" style="color:var(--muted)"><%= siteText("view.duhoc-detail.003") %></a> <span>›</span>
      <a href="<%= isSchoolPage?'/truong-dai-hoc':'/du-hoc' %>" style="color:var(--muted)"><%= isSchoolPage?siteText("view.duhoc-detail.009"):siteText("view.duhoc-detail.010") %></a> <span>›</span> <span><%= program.title %></span>
    </nav>
    <span class="post__cat" style="color:var(--sky)"><%= program.categoryLabel %></span>
    <h1 style="font-size:clamp(28px,4.4vw,44px);margin:12px 0 6px"><%= program.title %></h1>
    <% if (program.subtitle) { %><div class="prog__kr" style="font-size:18px;margin-bottom:20px"><%= program.subtitle %></div><% } else { %><div style="margin-bottom:20px"></div><% } %>
    <p class="source-meta" style="margin-bottom:24px"><strong><%= program.author_type==='person'?siteText("view.duhoc-detail.011"):siteText("view.duhoc-detail.012") %>:</strong> <% if (program.author_url) { %><a href="<%= program.author_url %>" target="_blank" rel="author noopener noreferrer"><%= program.author_name || 'SOL DREAM EDUCATION' %></a><% } else { %><%= program.author_name || 'SOL DREAM EDUCATION' %><% } %><% if (program.author_role) { %> — <%= program.author_role %><% } %> · <strong><%= siteText("view.duhoc-detail.004") %></strong> <time datetime="<%= modifiedTime %>"><%= program.updatedDateFull %></time></p>
    <div class="post__img <%= program.cover_image ? '' : program.cover %>" style="height:300px;border-radius:20px;margin-bottom:30px">
      <img class="post__cover<%= (!program.cover_image || program.cover_image === '/img/research-cover.svg') ? ' post__cover--fallback' : '' %>" <%- imageAttributes(program.cover_image || '/img/research-cover.svg') %> alt="<%= program.cover_alt || program.title %>" style="border-radius:20px">
    </div>
    <% if(program.cover_caption){ %><p class="cover-caption"><%= program.cover_caption %></p><% } %>
    <%- include('partials/article-extras',{item:program}) %>
    <div class="article-body" style="font-size:17px;line-height:1.8;color:var(--ink-2)">
      <%- responsiveContent(program.contentHtml) %>
    </div>
    <%- include('partials/article-sources',{item:program}) %>
    <%- include('partials/content-responsibility',{item:program,kind:'program'}) %>
    <% if (relatedFaqs && relatedFaqs.length) { %>
    <section class="related-faq" aria-labelledby="program-faq-title">
      <h2 id="program-faq-title"><%= siteText("view.duhoc-detail.005") %> <%= isSchoolPage?siteText("view.duhoc-detail.013"):siteText("view.duhoc-detail.014") %></h2>
      <div class="faq-list"><% relatedFaqs.forEach(function(faq){ %><details class="faq-item"><summary><%= faq.question %></summary><div class="faq-answer"><p><%= faq.answer %></p></div></details><% }); %></div>
    </section>
    <% } %>
    <% if (relatedPrograms.length) { %>
    <section class="related-content" aria-labelledby="related-programs-title">
      <h2 id="related-programs-title"><%= isSchoolPage?siteText("view.duhoc-detail.015"):siteText("view.duhoc-detail.016") %></h2>
      <ul><% relatedPrograms.forEach(function(item){ %><li><a href="<%= programPublicPath(item) %>"><%= item.title %></a><span><%= item.categoryLabel %> <%= siteText("view.duhoc-detail.006") %> <%= item.updatedDateFull %></span></li><% }); %></ul>
    </section>
    <% } %>
    <div style="margin-top:40px;padding-top:24px;border-top:1px solid var(--line)">
      <a href="<%= isSchoolPage?'/truong-dai-hoc':'/du-hoc' %>" class="btn btn-ghost">← <%= isSchoolPage?siteText("view.duhoc-detail.017"):siteText("view.duhoc-detail.018") %></a>
      <a href="<%= siteText("view.duhoc-detail.007") %>" class="btn btn-primary" style="margin-left:8px"><%= siteText("view.duhoc-detail.008") %></a>
    </div>
  </div>
</article>
</main>
