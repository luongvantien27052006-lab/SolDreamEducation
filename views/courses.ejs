<main>
<section class="section knowledge-hub">
  <div class="wrap">
    <nav class="crumbs" aria-label="<%= siteText("view.courses.001") %>"><a href="<%= siteText("view.courses.002") %>"><%= siteText("view.courses.003") %></a> <span>›</span> <span><%= siteText("view.courses.004") %></span></nav>
    <header class="knowledge-hero">
      <span class="eyebrow"><%= siteText("view.courses.005") %></span>
      <h1><%= siteText("view.courses.006") %></h1>
      <p><%= siteText("view.courses.007") %></p>
      <div class="source-meta"><strong><%= siteText("view.courses.008") %></strong> <%= siteText("view.courses.009") %> <strong><%= siteText("view.courses.010") %></strong> <%= siteText("view.courses.011") %><% if (updatedDateLabel) { %> · <strong><%= siteText("view.courses.012") %></strong> <%= updatedDateLabel %><% } %></div>
    </header>

    <section class="direct-answer" aria-labelledby="course-answer-title">
      <p class="direct-answer__label" id="course-answer-title"><%= siteText("view.courses.013") %></p>
      <p><strong><%= siteText("view.courses.014") %></strong> <%= siteText("view.courses.015") %></p>
      <% const feeLink = getBlock('course-fee-link'); if (feeLink.active) { %><p><a href="<%= feeLink.link_url %>"><%= feeLink.link_label %></a></p><% } %>
    </section>

    <% tuitionGroups.forEach(function(group) { %>
    <section class="knowledge-section course-tuition-group" aria-labelledby="tuition-<%= group.courses[0].financials.tuition2026.track %>">
      <h2 id="tuition-<%= group.courses[0].financials.tuition2026.track %>"><%= group.title %></h2>
      <div class="knowledge-table-wrap">
        <table class="knowledge-table course-tuition-table">
          <caption><%= siteText("view.courses.016") %></caption>
          <thead><tr>
            <th scope="col"><%= siteText("view.courses.017") %></th><th scope="col"><%= siteText("view.courses.018") %></th><th scope="col"><%= siteText("view.courses.019") %></th><th scope="col"><%= siteText("view.courses.020") %></th><th scope="col"><%= siteText("view.courses.021") %></th>
            <th scope="col"><%= siteText("view.courses.022") %></th><th scope="col"><%= siteText("view.courses.023") %></th><th scope="col"><%= siteText("view.courses.024") %></th><th scope="col"><%= siteText("view.courses.025") %></th><th scope="col"><%= siteText("view.courses.026") %></th>
          </tr></thead>
          <tbody>
            <% group.courses.forEach(function(course) { const spec = course.financials.tuition2026 || course.financials.classDetails; %>
            <tr>
              <td><strong><%= spec.code %></strong><br><a href="<%= course.url %>"><%= course.name %></a></td>
              <td><%= spec.sessions %> <%= siteText("view.courses.027") %></td>
              <td><%= spec.minutesPerSession %> <%= siteText("view.courses.028") %></td>
              <td><%= spec.totalHours %> <%= siteText("view.courses.029") %></td>
              <td><%= spec.estimatedWeeks %> <%= siteText("view.courses.030") %></td>
              <td><%= spec.instructors %></td>
              <td><%= spec.classSize %> <%= siteText("view.courses.031") %></td>
              <td><%= spec.minimumStudents %> <%= siteText("view.courses.032") %></td>
              <td><strong><%= course.price %></strong><br><a href="<%= course.url %>"><%= siteText("view.courses.033") %></a></td>
              <td><%= spec.textbook || '' %><br><%= spec.materials %></td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </section>
    <% }); %>

    <section class="knowledge-section">
      <h2><%= siteText("view.courses.034") %></h2>
      <ul>
        <li><strong><%= siteText("view.courses.035") %></strong> <%= siteText("view.courses.036") %></li>
        <li><strong><%= siteText("view.courses.037") %></strong> <%= siteText("view.courses.038") %></li>
        <li><strong><%= siteText("view.courses.039") %></strong> <%= siteText("view.courses.040") %></li>
        <li><strong><%= siteText("view.courses.041") %></strong> <%= siteText("view.courses.042") %></li>
        <li><strong><%= siteText("view.courses.043") %></strong> <%= siteText("view.courses.044") %></li>
      </ul>
    </section>

    <% if (otherCourses.length) { %>
    <section class="knowledge-section">
      <h2><%= siteText("view.courses.045") %></h2>
      <p class="section-lead"><%= siteText("view.courses.046") %></p>
      <div class="knowledge-grid course-knowledge-grid">
        <% otherCourses.forEach(function(course) { %>
        <article class="knowledge-card" id="<%= course.id %>">
          <div class="knowledge-card__top"><span><%= course.language %></span><span><%= siteText("view.courses.047") %></span></div>
          <h3><a href="<%= course.url %>"><%= course.name %></a></h3>
          <p class="section-lead"><%= course.blufSummary || course.description %></p>
          <p class="knowledge-card__fact"><strong><%= siteText("view.courses.048") %></strong> <%= course.price %></p>
          <a class="knowledge-card__link" href="<%= course.url %>"><%= siteText("view.courses.049") %></a>
        </article>
        <% }); %>
      </div>
    </section>
    <% } %>

    <aside class="source-note"><strong><%= siteText("view.courses.050") %></strong> <%= courseNotice %></aside>
  </div>
</section>
</main>
