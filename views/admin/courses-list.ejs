<div class="adm__head"><div><h1>Khóa học</h1><p>Thêm, sửa, ẩn/hiện và xóa các khóa đào tạo đang hiển thị trên website.</p></div><a class="btn2 btn2-primary" href="/admin/khoa-hoc/moi">+ Thêm khóa học</a></div>
<% if(flash){ %><div class="flash"><%= flash %></div><% } %>
<section class="panel"><div class="tbl-scroll"><table class="tbl"><thead><tr><th>Khóa học</th><th>Ngôn ngữ</th><th>Học phí</th><th>Thứ tự</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
<% courses.forEach(function(course){ %><tr><td><strong><%= course.name %></strong><br><small class="muted">/khoa-hoc/<%= course.slug %></small></td><td><span class="tag"><%= course.language %></span></td><td><%= course.price||'Chưa công bố' %></td><td><%= course.sort_order %></td><td><span class="pill <%= course.published?'on':'off' %>"><%= course.published?'Hiển thị':'Bản nháp' %></span></td><td><a class="lnk" href="/khoa-hoc/<%= course.slug %>" target="_blank">Xem</a><a class="lnk" href="/admin/khoa-hoc/<%= course.id %>/sua">Sửa</a><form class="inline" method="post" action="/admin/khoa-hoc/<%= course.id %>/toggle"><button class="lnk" type="submit"><%= course.published?'Ẩn':'Đăng' %></button></form><form class="inline" method="post" action="/admin/khoa-hoc/<%= course.id %>/xoa" onsubmit="return confirm('Xóa khóa học này?')"><button class="lnk lnk-del" type="submit">Xóa</button></form></td></tr><% }) %>
<% if(!courses.length){ %><tr><td colspan="6" class="muted">Chưa có khóa học.</td></tr><% } %></tbody></table></div></section>
