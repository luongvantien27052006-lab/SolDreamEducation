<div class="adm__head"><div><h1>Yêu cầu liên hệ</h1><p>Yêu cầu được tách theo đúng mục đích để đội ngũ xử lý nhanh hơn.</p></div></div>
<div class="flash<%= emailConfiguration.configured?'':' flash-err' %>"><strong>Email thông báo về trung tâm:</strong> <%= emailConfiguration.recipient %> · <%= emailConfiguration.configured?'Đã có cấu hình Resend. Đăng ký mới được xếp gửi tự động.':'Cần cấu hình Resend và địa chỉ gửi trong Railway. Đăng ký mới vẫn được lưu và chờ gửi.' %></div>
<% if(flash){ %><div class="flash"><%= flash %></div><% } %>
<% leadGroups.forEach(function(group){ %>
<section class="panel lead-group">
  <div class="panel__head"><h2><%= group.title %> <span class="pill"><%= group.rows.length %></span></h2></div>
  <div class="tbl-scroll"><table class="tbl"><thead><tr><th>Khách hàng</th><th>Nhu cầu</th><th>Thời gian</th><th>Thông báo</th><th>Trạng thái</th></tr></thead><tbody>
  <% group.rows.forEach(function(lead){ %><tr>
    <td><strong><%= lead.name %></strong><br><a href="tel:<%= lead.phone %>" class="lnk"><%= lead.phone %></a><br><a href="mailto:<%= lead.email %>" class="lnk"><%= lead.email||'Chưa có email' %></a></td>
    <td><%= lead.interest||'Chưa chọn' %><% if(lead.interest_detail){ %><br><strong><%= lead.interest_detail %></strong><% } %><br><a class="lnk" href="<%= lead.source_path||'/' %>" target="_blank"><%= lead.source_title||lead.source_path||'Trang chủ' %> ↗</a></td><td><%= lead.created_at %></td>
    <td><span class="pill <%= lead.email_status==='sent'?'on':'off' %>"><%= lead.email_status==='sent'?'Đã gửi email cho trung tâm':lead.email_status==='failed'?'Gửi email chưa thành công':lead.email_status==='sending'?'Đang gửi email':lead.email_status==='pending'?(lead.email_attempts?'Đang chờ thử gửi lại':'Đang chờ gửi email'):'Chưa xếp gửi email' %></span>
      <% if(lead.email_recipient){ %><br><small><%= lead.email_recipient %></small><% } %>
      <% if(lead.email_sent_at){ %><br><small><%= new Date(lead.email_sent_at).toLocaleString('vi-VN',{timeZone:'Asia/Ho_Chi_Minh'}) %></small><% } %>
      <% if(lead.email_error){ %><br><small><%= lead.email_error %></small><% } %>
      <% if(!lead.email_status||lead.email_status==='failed'){ %><form method="post" action="/admin/lien-he/<%= lead.id %>/gui-email" style="margin-top:8px"><button type="submit" class="btn2 btn2-ghost"><%= lead.email_status==='failed'?'Thử gửi lại':'Gửi thông báo email' %></button></form><% } %>
      <% if(lead.notified){ %><br><small>Đã gửi thông báo qua hotline.</small><% } %>
      <br><small class="muted">Bản tin của khách: <%= lead.subscription_active?'Đang đăng ký nhận':'Đã dừng nhận' %></small></td>
    <td><form method="post" action="/admin/lien-he/<%= lead.id %>/status"><select name="status" onchange="this.form.submit()"><option value="new" <%= lead.status==='new'?'selected':'' %>>Mới</option><option value="contacted" <%= lead.status==='contacted'?'selected':'' %>>Đã liên hệ</option><option value="closed" <%= lead.status==='closed'?'selected':'' %>>Đã đóng</option></select></form></td>
  </tr><% }) %>
  <% if(!group.rows.length){ %><tr><td colspan="5" class="muted">Chưa có yêu cầu trong nhóm này.</td></tr><% } %>
  </tbody></table></div>
</section>
<% }) %>
