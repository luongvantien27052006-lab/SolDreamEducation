<div class="adm__head"><div><h1><%= mode==='create'?'Tạo pop-up':'Sửa pop-up' %></h1><p><%= popup.system_key==='lead_capture'?'Đây là biểu mẫu đăng ký tự động trên các trang nội dung; độ trễ hiện tại được tính bằng giây.':'Có thể đặt thời gian và phạm vi hiển thị.' %></p></div><a href="/admin/popup" class="btn2 btn2-ghost">← Quay lại</a></div><% if(error){ %><div class="flash flash-err"><%= error %></div><% } %>
<form class="panel form" method="post" action="<%= mode==='create'?'/admin/popup/moi':'/admin/popup/'+popup.id+'/sua' %>"><div class="f"><label>Tiêu đề *</label><input name="title" value="<%= popup.title||'' %>" required></div><div class="f"><label>Nội dung</label><textarea name="content" rows="5"><%= popup.content||'' %></textarea></div><div class="f"><label>Ảnh (URL HTTPS hoặc /uploads/...)</label><input name="image_url" value="<%= popup.image_url||'' %>"></div><div class="row2"><div class="f"><label>Nhãn nút</label><input name="button_text" value="<%= popup.button_text||'' %>"></div><div class="f"><label>Liên kết nút</label><input name="button_url" value="<%= popup.button_url||'' %>"></div></div><div class="row3"><div class="f"><label>Vị trí</label><select name="placement"><option value="sitewide" <%= popup.placement==='sitewide'?'selected':'' %>>Toàn website</option><option value="home" <%= popup.placement==='home'?'selected':'' %>>Trang chủ</option><option value="content" <%= popup.placement==='content'?'selected':'' %>>Trang nội dung</option></select></div><div class="f"><label>Độ trễ (giây)</label><input type="number" min="0" max="60" name="delay_seconds" value="<%= popup.delay_seconds||0 %>"></div><div class="f"><label>Trạng thái</label><select name="active"><option value="0" <%= !popup.active?'selected':'' %>>Tắt</option><option value="1" <%= popup.active?'selected':'' %>>Bật</option></select></div></div><div class="row2"><div class="f"><label>Bắt đầu</label><input type="datetime-local" name="starts_at" value="<%= (popup.starts_at||'').replace(' ','T') %>"></div><div class="f"><label>Kết thúc</label><input type="datetime-local" name="ends_at" value="<%= (popup.ends_at||'').replace(' ','T') %>"></div></div><div class="f"><label><input type="checkbox" name="show_once" value="1" style="width:auto" <%= popup.show_once?'checked':'' %>> Chỉ hiện một lần trên thiết bị</label></div><div class="form__actions"><button class="btn2 btn2-primary" type="submit">Lưu pop-up</button><a class="btn2 btn2-ghost" href="/admin/popup">Hủy</a></div></form>
