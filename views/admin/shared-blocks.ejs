<div class="adm__head"><div><h1>Nội dung dùng chung</h1><p>Sửa tiêu đề, lời dẫn, thẻ giá trị, footer và nhãn tư vấn. Mỗi khối có thứ tự, bật/tắt, xem trước và lịch sử riêng.</p></div><a class="btn2 btn2-ghost" href="/" target="_blank">Xem website</a></div>
<% if(flash){ %><div class="flash"><%= flash %></div><% } %>
<p><a class="btn2 btn2-primary" href="/admin/giao-dien">Chỉnh chữ, menu và nội dung trên từng trang</a></p>
<section class="panel"><div class="tbl-scroll"><table class="tbl"><thead><tr><th>Vị trí</th><th>Nội dung</th><th>Thứ tự / trạng thái</th><th>Biên tập</th></tr></thead><tbody><% blocks.forEach(function(block){ %><tr><td><%= block.zone %><br><small><%= block.key %></small></td><td><strong><%= block.title||block.key %></strong><p><%= block.content.replace(/<[^>]+>/g,' ').slice(0,160) %></p></td><td><%= block.sort_order %> · <%= block.active?'Bật':'Tắt' %></td><td><a class="btn2 btn2-primary" href="/admin/noi-dung-chung/<%= block.key %>/sua">Sửa / xem trước</a><br><a href="/admin/lich-su/shared_blocks/<%= block.key %>">Lịch sử</a></td></tr><% }); %></tbody></table></div></section>
