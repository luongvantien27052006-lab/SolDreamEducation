<div class="adm__head"><div><h1>Pop-up</h1><p>Quản lý biểu mẫu đăng ký tự động và các thông báo chiến dịch trên website.</p></div><a href="/admin/popup/moi" class="btn2 btn2-primary">+ Tạo pop-up</a></div>
<% const placementLabels={sitewide:'Toàn website',home:'Trang chủ',content:'Trang nội dung'}; %>
<% if(flash){ %><div class="flash"><%= flash %></div><% } %><section class="panel"><div class="tbl-scroll"><table class="tbl"><thead><tr><th>Pop-up</th><th>Vị trí</th><th>Lịch hiển thị</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody><% popups.forEach(function(popup){ %><tr><td><strong><%= popup.title %></strong><% if(popup.system_key==='lead_capture'){ %><br><span class="tag">Biểu mẫu đăng ký tự động · sau <%= popup.delay_seconds %> giây</span><% } %></td><td><span class="tag"><%= placementLabels[popup.placement]||popup.placement %></span></td><td><small><%= popup.starts_at||'Hiệu lực ngay' %> → <%= popup.ends_at||'Không giới hạn' %></small></td><td><span class="pill <%= popup.active?'on':'off' %>"><%= popup.active?'Đang bật':'Đang tắt' %></span></td><td><a class="lnk" href="/admin/popup/<%= popup.id %>/sua">Sửa</a><form class="inline" method="post" action="/admin/popup/<%= popup.id %>/toggle"><button class="lnk" type="submit"><%= popup.active?'Tắt':'Bật' %></button></form><% if(!popup.system_key){ %><form class="inline" method="post" action="/admin/popup/<%= popup.id %>/xoa" onsubmit="return confirm('Xóa pop-up này?')"><button class="lnk lnk-del" type="submit">Xóa</button></form><% } %></td></tr><% }) %><% if(!popups.length){ %><tr><td colspan="5" class="muted">Chưa có pop-up.</td></tr><% } %></tbody></table></div></section>
