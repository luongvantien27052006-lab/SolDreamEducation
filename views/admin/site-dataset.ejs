<div class="adm__head"><div><h1><%= dataset.title %></h1><p>Chỉnh nội dung theo từng trường. Mã định danh và đường dẫn trang được giữ cố định.</p></div><a class="btn2 btn2-ghost" href="/admin/giao-dien">Quay lại</a></div>
<% if(flash){ %><div class="flash"><%= flash %></div><% } %>
<form method="get" class="panel form"><div class="f"><label>Tìm nội dung / tên trường dữ liệu</label><input name="q" value="<%= search %>"></div><button class="btn2 btn2-primary">Tìm</button></form>
<form method="post" class="panel form"><input type="hidden" name="page" value="<%= page %>"><input type="hidden" name="q" value="<%= search %>"><p><%= total %> trường · Trang <%= page %>/<%= pages %>. Chỉ các trường trên trang này được gửi khi lưu.</p>
<% fields.forEach(function(field){ %><div class="f"><label><%= field.label %></label><% if(field.kind==='boolean'){ %><select name="values[<%= field.token %>]" <%= field.readonly?'disabled':'' %>><option value="true" <%= field.value==='true'?'selected':'' %>>Có</option><option value="false" <%= field.value==='false'?'selected':'' %>>Không</option></select><% }else{ %><textarea rows="<%= field.value.length>180?4:2 %>" name="values[<%= field.token %>]" <%= field.readonly?'readonly':'' %>><%= field.value %></textarea><% } %><% if(field.readonly){ %><small>Định danh hoặc trường hệ thống, tự đồng bộ.</small><% } %></div><% }); %>
<div class="form__actions"><button type="submit" class="btn2 btn2-primary">Lưu nội dung trang này</button><a href="/admin/lich-su/site_datasets/<%= dataset.key %>">Lịch sử chỉnh sửa</a></div></form>
<nav style="display:flex;gap:16px;margin:24px 0"><% if(page>1){ %><a href="?<%= new URLSearchParams({q:search,trang:String(page-1)}).toString() %>">← Trang trước</a><% }if(page<pages){ %><a href="?<%= new URLSearchParams({q:search,trang:String(page+1)}).toString() %>">Trang sau →</a><% } %></nav>
