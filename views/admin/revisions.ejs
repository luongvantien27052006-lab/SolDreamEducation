<div class="adm__head"><div><h1>Lịch sử chỉnh sửa</h1><p>Lưu bản trước khi thay đổi, gồm cả nội dung và trạng thái. Có thể sao chép lại phần cần khôi phục vào trình biên tập.</p></div><button class="btn2 btn2-ghost" onclick="history.back()">Quay lại</button></div>
<% revisions.forEach(function(r){ %><details class="panel"><summary><%= r.created_at %> UTC · <%= r.action %> · bản #<%= r.id %></summary><pre style="white-space:pre-wrap;overflow-wrap:anywhere"><%= JSON.stringify(JSON.parse(r.snapshot),null,2) %></pre></details><% }); %><% if(!revisions.length){ %><p>Chưa có thay đổi được lưu từ khi bật lịch sử.</p><% } %>
