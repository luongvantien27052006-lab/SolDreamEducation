<div class="adm__head"><div><h1><%= mode==='create'?'Thêm khóa học':'Sửa khóa học' %></h1><p>Dữ liệu đã xuất bản sẽ tự đồng bộ sang trang khóa học, sitemap và chatbot.</p></div><a class="btn2 btn2-ghost" href="/admin/khoa-hoc">← Quay lại</a></div>
<% if(error){ %><div class="flash flash-err"><%= error %></div><% } %>
<form data-preview-type="course" class="panel form" method="post" action="<%= mode==='create'?'/admin/khoa-hoc/moi':'/admin/khoa-hoc/'+course.id+'/sua' %>">
  <div class="row2"><div class="f"><label>Tên khóa học *</label><input name="name" value="<%= course.name||'' %>" required></div><div class="f"><label>Đường dẫn</label><input name="slug" value="<%= course.slug||'' %>" placeholder="tieng-han-so-cap"></div></div>
  <div class="row3"><div class="f"><label>Ngôn ngữ</label><input name="language" value="<%= course.language||'Tiếng Hàn' %>"></div><div class="f"><label>Thứ tự</label><input type="number" name="sort_order" value="<%= course.sort_order||0 %>"></div><div class="f"><label>Ngày cập nhật</label><input type="date" name="last_updated" value="<%= course.last_updated||course.lastUpdated||'' %>"></div></div>
  <div class="f"><label>Tóm tắt BLUF</label><textarea name="bluf_summary" rows="4" maxlength="700" placeholder="Tóm tắt trực tiếp đối tượng, nội dung, học phí và điều kiện cần xác nhận..."><%= course.bluf_summary||course.blufSummary||'' %></textarea><small class="muted">Khuyến nghị 40–50 từ để chatbot và công cụ tìm kiếm trích xuất chính xác.</small></div>
  <div class="f"><label>Đối tượng phù hợp</label><textarea name="audience" rows="2"><%= course.audience||'' %></textarea></div>
  <div class="f"><label>Mô tả khóa học</label><textarea name="description" rows="5"><%= course.description||'' %></textarea></div>
  <div class="row2"><div class="f"><label>Học phí hiển thị</label><input name="price" value="<%= course.price||'' %>" placeholder="1.890.000 VNĐ trọn khóa"></div><div class="f"><label>Học phí số hóa (VND)</label><input type="number" min="0" name="price_vnd_total" value="<%= course.financials && course.financials.priceVndTotal!=null?course.financials.priceVndTotal:'' %>"></div></div>
  <div class="f"><label>Ghi chú học phí</label><input name="price_note" value="<%= course.financials?course.financials.priceNote||'':'' %>"></div>
  <div class="row2"><div class="f"><label>Trình độ đầu vào</label><input name="entry_level" value="<%= course.requirements?course.requirements.entryLevel||'':'' %>"></div><div class="f"><label>Chứng chỉ đầu vào</label><input name="certificate_required" value="<%= course.requirements?(course.requirements.certificateRequired||course.requirements.englishCertificateRequired||course.requirements.topikRequired||''):'' %>" placeholder="Tiếng Hàn: TOPIK · Tiếng Anh: TOEIC hoặc IELTS"><small class="muted">Hệ thống tự hiển thị TOPIK cho khóa tiếng Hàn và TOEIC/IELTS cho khóa tiếng Anh.</small></div></div>
  <div class="f"><label>Ghi chú điều kiện</label><textarea name="requirement_status" rows="3"><%= course.requirements?course.requirements.status||'':'' %></textarea></div>
<% const classSpec = (course.financials && (course.financials.tuition2026 || course.financials.classDetails)) || {}; %><h2>Thông số lớp dùng chung</h2><p>Trang chủ, bảng học phí, chi tiết, FAQ và tư vấn cùng sử dụng các trường này. Hãy sửa đồng thời mô tả nếu có nhắc lại thông số.</p><div class="row2"><div class="f"><label>Sĩ số (khác ngưỡng mở lớp)</label><input name="class_size" type="text"  value="<%= classSpec.classSize == null ? '' : classSpec.classSize %>"></div><div class="f"><label>Giáo trình</label><input name="textbook" type="text"  value="<%= classSpec.textbook == null ? '' : classSpec.textbook %>"></div><div class="f"><label>Tài liệu bổ trợ</label><input name="materials" type="text"  value="<%= classSpec.materials == null ? '' : classSpec.materials %>"></div><div class="f"><label>Cơ cấu giáo viên</label><input name="instructors" type="text"  value="<%= classSpec.instructors == null ? '' : classSpec.instructors %>"></div><div class="f"><label>Số buổi</label><input name="sessions" type="number" min="0" step="any" value="<%= classSpec.sessions == null ? '' : classSpec.sessions %>"></div><div class="f"><label>Phút mỗi buổi</label><input name="minutes_per_session" type="number" min="0" step="any" value="<%= classSpec.minutesPerSession == null ? '' : classSpec.minutesPerSession %>"></div><div class="f"><label>Tổng số giờ</label><input name="total_hours" type="number" min="0" step="any" value="<%= classSpec.totalHours == null ? '' : classSpec.totalHours %>"></div><div class="f"><label>Số tuần dự kiến</label><input name="estimated_weeks" type="number" min="0" step="any" value="<%= classSpec.estimatedWeeks == null ? '' : classSpec.estimatedWeeks %>"></div><div class="f"><label>Tối thiểu học viên để mở lớp</label><input name="minimum_students" type="number" min="0" step="any" value="<%= classSpec.minimumStudents == null ? '' : classSpec.minimumStudents %>"></div></div>
  <div class="f"><label>Trạng thái</label><select name="published"><option value="0" <%= !course.published?'selected':'' %>>Bản nháp</option><option value="1" <%= course.published?'selected':'' %>>Hiển thị</option></select></div>
<div class="row2"><div class="f"><label>Tiêu đề SEO</label><input name="seo_title" value="<%= course.seo_title||'' %>"></div><div class="f"><label>Mô tả SEO</label><textarea name="meta_description" rows="3"><%= course.meta_description||'' %></textarea></div></div>
  <div class="form__actions"><button class="btn2 btn2-primary" type="submit">Lưu khóa học</button><a class="btn2 btn2-ghost" href="/admin/khoa-hoc">Hủy</a></div>
</form>

