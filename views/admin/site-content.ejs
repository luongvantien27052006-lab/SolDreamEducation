<div class="adm__head"><div><h1>Giao diện &amp; nội dung trang</h1><p>Chọn trang hoặc khu vực để chỉnh chữ, nút, liên kết, lời dẫn và thông báo.</p></div><a class="btn2 btn2-ghost" href="/admin/noi-dung-chung">Các khối nội dung dùng chung</a></div>
<% if(flash){ %><div class="flash"><%= flash %></div><% } %>
<section class="panel"><h2>Nội dung trang theo dữ liệu</h2><div style="display:flex;gap:12px;flex-wrap:wrap"><% datasets.forEach(function(row){ %><a href="/admin/du-lieu-trang/<%= row.key %>"><%= row.title %></a><% }); %></div></section>
<form method="get" class="panel form"><div class="row2"><div class="f"><label>Trang / khu vực</label><select name="nhom"><% groups.forEach(function(row){ %><option value="<%= row.group_name %>" <%= row.group_name===group?'selected':'' %>><%= row.group_name %> (<%= row.total %>)</option><% }); %></select></div><div class="f"><label>Tìm chữ cần sửa trong khu vực</label><input name="q" value="<%= search %>"></div></div><button class="btn2 btn2-primary">Mở nội dung</button></form>
<form method="post" action="/admin/giao-dien" class="panel form"><input type="hidden" name="group" value="<%= group %>"><input type="hidden" name="page" value="<%= page %>"><input type="hidden" name="q" value="<%= search %>"><h2><%= group %></h2><p><%= total %> trường · Trang <%= page %>/<%= pages %>. Nội dung đã có trong CMS được bảo toàn khi cập nhật mã nguồn.</p>
<% fields.forEach(function(field){ %><div class="f"><label><%= field.label %></label><% if(field.kind==='url'){ %><input name="values[<%= field.key %>]" value="<%= field.value %>" type="text"><% }else{ %><textarea rows="<%= field.value.length>180?4:2 %>" name="values[<%= field.key %>]"><%= field.value %></textarea><% } %><small><%= field.key %> · <a href="/admin/lich-su/site_copy/<%= field.key %>">Lịch sử</a><% if(/\{v\d+\}/.test(field.default_value)){ %> · Giữ nguyên các biến {v0}, {v1}… để giữ dữ liệu động.<% } %></small></div><% }); %>
<button class="btn2 btn2-primary" type="submit">Lưu các nội dung đang hiển thị</button></form>
<nav style="display:flex;gap:16px;margin:24px 0"><% if(page>1){ %><a href="?<%= new URLSearchParams({nhom:group,q:search,trang:String(page-1)}).toString() %>">← Trang trước</a><% }if(page<pages){ %><a href="?<%= new URLSearchParams({nhom:group,q:search,trang:String(page+1)}).toString() %>">Trang sau →</a><% } %></nav>
