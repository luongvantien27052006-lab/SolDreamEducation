<main>
<section class="section" style="padding-top:56px">
  <div class="wrap">
    <nav class="crumbs" aria-label="<%= siteText("view.news-list.001") %>" style="font-size:14px;color:var(--muted);margin-bottom:14px">
      <a href="<%= siteText("view.news-list.002") %>" style="color:var(--muted)"><%= siteText("view.news-list.003") %></a> <span>›</span> <span><%= currentTopic ? currentTopic.label : siteText("view.news-list.018") %></span>
    </nav>
    <div class="sec-head">
      <span class="eyebrow"><%= siteText("view.news-list.004") %></span>
      <h1><%= currentTopic ? currentTopic.label : siteText("view.news-list.019") %></h1>
      <p><%= currentTopic ? currentTopic.description : siteText("view.news-list.020") %></p>
      <div class="source-meta"><strong><%= siteText("view.news-list.005") %></strong> <%= siteText("view.news-list.006") %></div>
    </div>
    <section class="direct-answer list-direct-answer" aria-label="<%= siteText("view.news-list.007") %>">
      <p class="direct-answer__label"><%= siteText("view.news-list.008") %></p>
      <p><strong><%= siteText("view.news-list.009") %></strong> <%= siteText("view.news-list.010") %></p>
    </section>
    <nav class="topic-tabs" aria-label="<%= siteText("view.news-list.011") %>">
      <a href="<%= siteText("view.news-list.012") %>" class="<%= !selectedTopic ? 'is-active' : '' %>" aria-current="<%= !selectedTopic ? 'page' : 'false' %>"><%= siteText("view.news-list.013") %> <span><%= Object.values(topicCounts).reduce((total, count) => total + count, 0) %></span></a>
      <% topics.forEach(function(topic) { %><a href="/tin-tuc?muc=<%= topic.id %>" class="<%= selectedTopic === topic.id ? 'is-active' : '' %>" aria-current="<%= selectedTopic === topic.id ? 'page' : 'false' %>"><%= topic.label %> <span><%= topicCounts[topic.id] || 0 %></span></a><% }); %>
    </nav>
    <% if (selectedTopic === 'cam-nang-sinh-hoat') { %><aside class="topic-feature"><strong><%= siteText("view.news-list.014") %></strong> <a href="<%= siteText("view.news-list.015") %>"><%= siteText("view.news-list.016") %></a></aside><% } %>
    <div class="news-grid">
      <% posts.forEach(function(p){ %>
      <a class="post" href="/tin-tuc/<%= p.slug %>">
        <div class="post__img <%= p.cover_image ? '' : p.cover %>">
          <img class="post__cover<%= (!p.cover_image || p.cover_image === '/img/research-cover.svg') ? ' post__cover--fallback' : '' %>" <%- imageAttributes(p.cover_image || '/img/research-cover.svg', '(max-width: 720px) 100vw, 420px') %> alt="<%= p.title %>" loading="lazy">
          <div class="post__date"><b><%= p.day %></b><span><%= p.monthYear %></span></div>
        </div>
        <div class="post__body"><span class="post__cat"><%= p.topicLabel %></span>
          <h3><%= p.title %></h3>
          <p class="section-lead"><%= p.geoBluf %></p>
        </div>
      </a>
      <% }); %>
      <% if (posts.length === 0) { %><p><%= siteText("view.news-list.017") %></p><% } %>
    </div>
  </div>
</section>
</main>
