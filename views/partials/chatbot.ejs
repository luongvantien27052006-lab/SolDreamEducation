<aside class="chatbot" aria-label="<%= siteText("view.partials.chatbot.001") %>">
  <% if (typeof showChatHint !== 'undefined' && showChatHint) { %>
    <a class="chatbot__hint" href="<%= siteText("view.partials.chatbot.002") %>">
      <strong><%= getBlock("chat-hint").title %></strong>
      <span><%- getBlock("chat-hint").content %></span>
    </a>
  <% } %>
  <a class="chatbot__launcher" href="<%= siteText("view.partials.chatbot.003") %>" aria-label="<%= siteText("view.partials.chatbot.004") %>">
    <img class="chatbot__launcher-icon" src="/img/soldream-robot.png?v=sde3" alt="" aria-hidden="true">
    <span class="chatbot__launcher-pulse" aria-hidden="true"></span>
  </a>
</aside>
