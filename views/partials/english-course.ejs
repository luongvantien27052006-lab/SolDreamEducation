<header class="english-hero">
  <div class="english-hero__copy">
    <span class="eyebrow"><%= englishContent.eyebrow %></span>
    <h1><%= course.name %></h1>
    <p class="english-hero__headline"><%= englishContent.headline %></p>
    <p class="english-hero__intro"><%= englishContent.intro %></p>
    <div class="english-actions">
      <a class="btn btn-primary" href="#lienhe"><%= englishContent.primaryLabel %> <span aria-hidden="true">↗</span></a>
      <a class="english-text-link" href="#english-methods"><%= englishContent.secondaryLabel %> <span aria-hidden="true">↓</span></a>
    </div>
  </div>
  <figure class="english-hero__photo">
    <img <%- imageAttributes(englishContent.heroImage, '(max-width: 900px) 100vw, 560px') %> alt="<%= englishContent.heroAlt %>" fetchpriority="high">
    <figcaption><%= englishContent.heroCaption %></figcaption>
  </figure>
</header>

<section class="english-section" aria-labelledby="english-goals-title">
  <div class="english-section__head"><h2 id="english-goals-title"><%= englishContent.goalsTitle %></h2><p><%= englishContent.goalsLead %></p></div>
  <div class="english-goals">
    <% englishContent.goals.forEach(function(item, index){ %>
    <article class="english-goal"><span class="english-number" aria-hidden="true"><%= String(index + 1).padStart(2, '0') %></span><h3><%= item.title %></h3><p><%= item.text %></p></article>
    <% }); %>
  </div>
</section>

<section class="english-section english-methods" id="english-methods" aria-labelledby="english-methods-title">
  <div class="english-section__head"><span class="eyebrow"><%= course.language %></span><h2 id="english-methods-title"><%= englishContent.methodsTitle %></h2><p><%= englishContent.methodsLead %></p></div>
  <div class="english-skills">
    <% const icons = ['<path d="M4 14v-3a8 8 0 0 1 16 0v3M4 13h3v7H5a1 1 0 0 1-1-1zm16 0h-3v7h2a1 1 0 0 0 1-1z"/>','<path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8A8.5 8.5 0 0 1 8.7 4a8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.4Z"/>','<path d="M12 5v16M3 3h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5v16h-5a4 4 0 0 0-4 2 4 4 0 0 0-4-2H3Z"/>','<path d="m16 3 5 5-12 12-6 1 1-6Zm-2 2 5 5M3 21l5-1-4-4"/>']; %>
    <% englishContent.methods.forEach(function(item, index){ %>
    <article class="english-skill"><span class="english-skill__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><%- icons[index % icons.length] %></svg></span><h3><%= item.title %></h3><p><%= item.text %></p></article>
    <% }); %>
  </div>
</section>

<section class="english-section" aria-labelledby="english-gallery-title">
  <div class="english-section__head"><h2 id="english-gallery-title"><%= englishContent.galleryTitle %></h2><p><%= englishContent.galleryLead %></p></div>
  <div class="english-gallery">
    <% englishContent.gallery.forEach(function(photo){ %>
    <figure><img <%- imageAttributes(photo.image, '(max-width: 600px) 100vw, (max-width: 900px) 50vw, 400px') %> alt="<%= photo.alt %>" loading="lazy" decoding="async"><figcaption><%= photo.caption %></figcaption></figure>
    <% }); %>
  </div>
</section>
