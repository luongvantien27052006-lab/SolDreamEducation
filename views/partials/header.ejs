<header class="site-header">
  <div class="wrap nav">
    <a href="<%= siteText("view.partials.header.001") %>" class="brand" aria-label="<%= siteText("view.partials.header.002") %>">
      <img class="brand__logo" src="/img/logo-mark.png" alt="<%= siteText("view.partials.header.003") %>" width="48" height="48">
      <span class="brand__wordmark" aria-hidden="true">
        <strong><%= siteText("view.partials.header.004") %></strong>
        <small><i></i><span><%= siteText("view.partials.header.005") %></span><i></i></small>
      </span>
    </a>
    <nav aria-label="<%= siteText("view.partials.header.006") %>">
      <button class="menu-close" id="menu-close" type="button" aria-label="<%= siteText("view.partials.header.007") %>">
        <span aria-hidden="true">×</span>
      </button>
      <ul class="menu" id="menu">
        <li><a href="<%= siteText("view.partials.header.008") %>"><%= siteText("view.partials.header.009") %></a></li>
        <li><a href="<%= siteText("view.partials.header.010") %>"><%= siteText("view.partials.header.011") %> <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m6 9 6 6 6-6"/></svg></a>
          <div class="dropdown">
            <a href="<%= siteText("view.partials.header.012") %>"><%= siteText("view.partials.header.013") %></a>
            <a href="<%= siteText("view.partials.header.014") %>"><%= siteText("view.partials.header.015") %></a>
            <a href="<%= siteText("view.partials.header.016") %>"><%= siteText("view.partials.header.017") %></a>
            <a href="<%= siteText("view.partials.header.018") %>"><%= siteText("view.partials.header.019") %></a>
            <span class="dropdown__label"><%= siteText("view.partials.header.020") %></span>
            <% (typeof navigationCourses !== 'undefined' ? navigationCourses : []).forEach(function(course){ %>
              <a href="<%= course.url %>"><%= course.name %></a>
            <% }) %>
          </div>
        </li>
        <li><a href="<%= siteText("view.partials.header.021") %>"><%= siteText("view.partials.header.022") %> <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m6 9 6 6 6-6"/></svg></a>
          <div class="dropdown">
            <a href="<%= siteText("view.partials.header.023") %>"><%= siteText("view.partials.header.024") %></a>
            <a href="<%= siteText("view.partials.header.025") %>"><%= siteText("view.partials.header.026") %></a>
            <a href="<%= siteText("view.partials.header.027") %>"><%= siteText("view.partials.header.028") %></a>
            <a href="<%= siteText("view.partials.header.029") %>"><%= siteText("view.partials.header.030") %></a>
            <a href="<%= siteText("view.partials.header.031") %>"><%= siteText("view.partials.header.032") %></a>
            <div class="dropdown__schools">
              <a class="dropdown__section" href="<%= siteText("view.partials.header.033") %>"><%= siteText("view.partials.header.034") %></a>
              <a href="<%= siteText("view.partials.header.035") %>"><%= siteText("view.partials.header.036") %></a>
              <a href="<%= siteText("view.partials.header.037") %>"><%= siteText("view.partials.header.038") %></a>
              <a href="<%= siteText("view.partials.header.039") %>"><%= siteText("view.partials.header.040") %></a>
            </div>
          </div>
        </li>
        <li><a class="menu__life" href="<%= siteText("navigation.soldream-life.url") %>"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z"/></svg><span><%= siteText("navigation.soldream-life.label") %></span><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z"/></svg></a></li>
        <li><a href="<%= siteText("view.partials.header.041") %>"><%= siteText("view.partials.header.042") %> <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m6 9 6 6 6-6"/></svg></a>
          <div class="dropdown">
            <a href="<%= siteText("view.partials.header.043") %>"><%= siteText('topic.thong-tin-han-quoc.label') %></a>
            <a href="<%= siteText("view.partials.header.045") %>"><%= siteText('topic.cam-nang-sinh-hoat.label') %></a>
            <a href="<%= siteText("view.partials.header.047") %>"><%= siteText('topic.hoat-dong-soldream.label') %></a>
          </div>
        </li>
        <li><a href="<%= siteText("view.partials.header.049") %>"><%= siteText("view.partials.header.050") %></a></li>
        <li><a href="<%= siteText("view.partials.header.051") %>"><%= siteText("view.partials.header.052") %></a></li>
      </ul>
    </nav>
    <div class="nav__cta">
      <a href="<%= siteText("view.partials.header.053") %>" class="btn btn-primary"><%= getBlock("consult-button").title %></a>
      <button class="burger" id="burger" type="button" aria-label="<%= siteText("view.partials.header.054") %>" aria-expanded="false" aria-controls="menu"><span></span><span></span><span></span></button>
    </div>
  </div>
  <div class="backdrop" id="backdrop"></div>
</header>
