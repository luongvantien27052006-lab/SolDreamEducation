<% if (typeof sitePopup !== 'undefined' && sitePopup) { %>
<div class="site-popup" data-site-popup data-popup-id="<%= sitePopup.id %>" data-popup-delay="<%= sitePopup.delay_seconds %>" data-popup-once="<%= sitePopup.show_once %>" hidden>
  <button class="site-popup__backdrop" type="button" data-popup-close aria-label="Đóng thông báo"></button>
  <section class="site-popup__card" role="dialog" aria-modal="true" aria-labelledby="site-popup-title-<%= sitePopup.id %>">
    <button class="site-popup__close" type="button" data-popup-close aria-label="Đóng">×</button>
    <% if(sitePopup.image_url){ %><img src="<%= sitePopup.image_url %>" alt="" loading="lazy"><% } %>
    <div class="site-popup__body"><h2 id="site-popup-title-<%= sitePopup.id %>"><%= sitePopup.title %></h2><div><%- sitePopup.content %></div>
    <% if(sitePopup.button_text && sitePopup.button_url){ %><a class="btn btn-primary" href="<%= sitePopup.button_url %>"><%= sitePopup.button_text %></a><% } %></div>
  </section>
</div>
<% } %>
