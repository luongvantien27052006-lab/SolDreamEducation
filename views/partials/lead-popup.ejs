<% if (typeof leadPopup !== 'undefined' && leadPopup) { %>
<div class="site-popup lead-popup" data-lead-popup data-popup-delay="<%= leadPopup.delay_seconds %>" hidden>
  <button class="site-popup__backdrop" type="button" data-lead-popup-close aria-label="<%= siteText("view.partials.lead-popup.001") %>"></button>
  <section class="site-popup__card lead-popup__card" role="dialog" aria-modal="true" aria-labelledby="lead-popup-title">
    <button class="site-popup__close" type="button" data-lead-popup-close aria-label="<%= siteText("view.partials.lead-popup.002") %>">×</button>
    <div class="site-popup__body">
      <span class="eyebrow"><%= siteText("view.partials.lead-popup.003") %></span>
      <h2 id="lead-popup-title"><%= leadPopup.title %></h2>
      <div class="section-lead"><%- leadPopup.content %></div>
      <form data-lead-form>
        <div class="field"><label for="lead-popup-name"><%= getBlock("consult-label-name").title %></label><input id="lead-popup-name" name="name" type="text" autocomplete="name" minlength="2" maxlength="100" placeholder="<%= siteText("view.partials.lead-popup.004") %>" required></div>
        <div class="field"><label for="lead-popup-phone"><%= getBlock("consult-label-phone").title %></label><input id="lead-popup-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" minlength="9" maxlength="20" placeholder="<%= siteText("view.partials.lead-popup.005") %>" required></div>
        <div class="field"><label for="lead-popup-email"><%= getBlock("consult-label-email").title %></label><input id="lead-popup-email" name="email" type="email" autocomplete="email" maxlength="180" placeholder="<%= siteText("view.partials.lead-popup.006") %>" required></div>
        <div class="field"><label for="lead-popup-interest"><%= getBlock("consult-label-interest").title %></label><input id="lead-popup-interest" name="interest" type="text" value="<%= leadContext ? leadContext.interest : siteText("view.partials.lead-popup.011") %>" readonly></div>
        <div class="field hp-field" aria-hidden="true"><label for="lead-popup-website"><%= siteText("view.partials.lead-popup.007") %></label><input id="lead-popup-website" name="website" tabindex="-1" autocomplete="off"></div>
        <input type="hidden" name="contextLocked" value="1">
        <input type="hidden" name="formStartedAt" value="">
        <button class="btn btn-primary" type="submit" data-lead-submit><%= leadPopup.button_text || siteText("view.partials.lead-popup.012") %></button>
        <p class="form-note" data-lead-status role="status" aria-live="polite"></p>
      </form>
      <div class="lead-popup__choices" aria-label="<%= siteText("view.partials.lead-popup.008") %>">
        <button type="button" data-lead-dismiss-session><%= siteText("view.partials.lead-popup.009") %></button>
        <button type="button" data-lead-remind><%= siteText("view.partials.lead-popup.010") %></button>
      </div>
    </div>
  </section>
</div>
<% } %>
