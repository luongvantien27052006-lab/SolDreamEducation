<main>
<article class="section knowledge-detail">
  <div class="wrap knowledge-layout">
    <div class="knowledge-main">
      <nav class="crumbs" aria-label="<%= siteText("view.university-detail.001") %>">
        <a href="<%= siteText("view.university-detail.002") %>"><%= siteText("view.university-detail.003") %></a> <span>›</span>
        <a href="<%= siteText("view.university-detail.004") %>"><%= siteText("view.university-detail.005") %></a> <span>›</span>
        <span><%= university.name %></span>
      </nav>

      <header class="knowledge-title">
        <span class="post__cat"><%= siteText("view.university-detail.006") %></span>
        <h1><%= university.name %></h1>
        <span class="freshness-badge"><%= university.freshnessLabel %></span>
        <div class="geo-summary-box" aria-label="<%= siteText("view.university-detail.007") %>">
          <p class="geo-summary-box__bluf"><%= university.blufSummary %></p>
          <ul class="geo-summary-box__facts">
            <li><strong><%= siteText("view.university-detail.008") %></strong> <%= university.coreFacts.firstYearTotal %></li>
            <li><strong><%= siteText("view.university-detail.009") %></strong> <%= university.coreFacts.visa %></li>
            <li><strong><%= siteText("view.university-detail.010") %></strong> <%= university.financials.kStudyDeposit.amountUsd ? university.financials.kStudyDeposit.amountUsd.toLocaleString('en-US') + ' USD' : siteText("view.university-detail.056") %></li>
            <li><strong><%= siteText("view.university-detail.011") %></strong> <%= university.coreFacts.gpa %></li>
          </ul>
        </div>
        <p class="knowledge-title__names"><%= university.english_name %></p>
        <div class="source-meta"><strong><%= siteText("view.university-detail.012") %></strong> <%= siteText("view.university-detail.013") %> <strong><%= siteText("view.university-detail.014") %></strong> <time datetime="<%= university.updatedDate %>"><%= university.updatedDateDisplay %></time></div>
      </header>

      <nav class="knowledge-toc" aria-label="<%= siteText("view.university-detail.015") %>">
        <strong><%= siteText("view.university-detail.016") %></strong>
        <% university.sections.forEach(function(section){ %><a href="#<%= section.id %>"><%= section.title %></a><% }); %>
      </nav>

      <section class="knowledge-section" id="chi-phi-dinh-luong">
        <h2><%= siteText("view.university-detail.017") %> <%= university.name %> <%= siteText("view.university-detail.018") %></h2>
        <p class="section-lead"><%= siteText("view.university-detail.019") %> <%= university.name %>. <% if (university.financials.conversion && university.financials.conversion.rateVndPerKrw) { %><%= siteText("view.university-detail.020") %><%= university.financials.conversion.rateVndPerKrw %> <%= siteText("view.university-detail.021") %> <%= university.financials.conversion.asOf %><%= siteText("view.university-detail.022") %><% } else { %><%= siteText("view.university-detail.023") %><% } %></p>
        <div class="knowledge-table-wrap"><table class="geo-data-table">
          <thead><tr><th scope="col"><%= siteText("view.university-detail.024") %></th><th scope="col"><%= siteText("view.university-detail.025") %></th><th scope="col"><%= siteText("view.university-detail.026") %></th><th scope="col"><%= siteText("view.university-detail.027") %></th></tr></thead>
          <tbody>
            <% university.costComparison.forEach(function(row){ %>
            <tr><th scope="row"><%= row.item %></th><td><%= row.foreignAmount %></td><td><%= row.vndAmount %></td><td><%= row.note %></td></tr>
            <% }); %>
          </tbody>
        </table></div>
      </section>

      <section class="knowledge-section" id="dieu-kien-tuyen-sinh-visa">
        <h2><%= siteText("view.university-detail.028") %> <%= university.name %> <%= siteText("view.university-detail.029") %></h2>
        <p class="section-lead"><%= siteText("view.university-detail.030") %> <%= university.name %><%= siteText("view.university-detail.031") %></p>
        <div class="knowledge-table-wrap"><table class="geo-data-table">
          <thead><tr><th scope="col"><%= siteText("view.university-detail.032") %></th><th scope="col"><%= siteText("view.university-detail.033") %></th><th scope="col"><%= siteText("view.university-detail.034") %></th></tr></thead>
          <tbody><% university.admissionRows.forEach(function(row){ %><tr><th scope="row"><%= row.criterion %></th><td><%= row.value %></td><td><%= row.note %></td></tr><% }); %></tbody>
        </table></div>
      </section>

      <% university.sections.forEach(function(section){ %>
      <section class="knowledge-section" id="<%= section.id %>">
        <h2><%= section.title %></h2>
        <p class="section-lead"><%= section.lead %></p>
        <% section.blocks.forEach(function(block){ %>
          <% if (block.type === 'heading') { %>
            <h3><%= block.text %></h3>
            <p class="section-lead"><%= block.lead %></p>
          <% } else if (block.type === 'list') { %>
            <ul><% block.items.forEach(function(item){ %><li><%= item %></li><% }); %></ul>
          <% } else if (block.type === 'table') { %>
            <div class="knowledge-table-wrap"><table class="knowledge-table">
              <thead><tr><% block.headers.forEach(function(cell){ %><th scope="col"><%= cell %></th><% }); %></tr></thead>
              <tbody><% block.rows.forEach(function(row){ %><tr><% row.forEach(function(cell){ %><td><%= cell %></td><% }); %></tr><% }); %></tbody>
            </table></div>
          <% } else { %>
            <p><%= block.text %></p>
          <% } %>
        <% }); %>
      </section>
      <% }); %>

      <section class="knowledge-section university-faq" id="cau-hoi-thuong-gap">
        <h2><%= siteText("view.university-detail.035") %> <%= university.name %></h2>
        <p class="section-lead"><%= siteText("view.university-detail.036") %></p>
        <% universityFaqs.forEach(function(faq, index){ %>
        <details class="faq-item" id="faq-<%= index + 1 %>" <%= index === 0 ? 'open' : '' %>>
          <summary><%= faq.question %></summary>
          <p class="section-lead"><%= faq.answer %></p>
        </details>
        <% }); %>
      </section>

      <section class="author-box" aria-labelledby="advisor-title">
        <h2 id="advisor-title"><%= siteText("view.university-detail.037") %></h2>
        <% if (advisor) { %>
          <p class="section-lead"><strong><%= advisor.name %></strong> — <%= advisor.jobTitle %><%= siteText("view.university-detail.038") %></p>
          <% if (advisor.hasCredential && advisor.hasCredential.length) { %><ul><% advisor.hasCredential.forEach(function(credential){ %><li><%= credential.name %></li><% }); %></ul><% } %>
          <% if (advisor.sameAs && advisor.sameAs.length) { %><p><a href="<%= advisor.sameAs[0] %>" rel="me noopener" target="_blank"><%= siteText("view.university-detail.039") %></a></p><% } %>
        <% } else { %>
          <p class="section-lead"><strong><%= siteText("view.university-detail.040") %></strong> <%= siteText("view.university-detail.041") %></p>
        <% } %>
      </section>

      <section class="source-box" aria-labelledby="source-title">
        <h2 id="source-title"><%= siteText("view.university-detail.042") %></h2>
        <p class="section-lead"><%= siteText("view.university-detail.043") %></p>
        <% if (university.officialWebsite) { %><p><strong><%= siteText("view.university-detail.044") %></strong> <a href="<%= university.officialWebsite %>" target="_blank" rel="noopener noreferrer"><%= siteText("view.university-detail.045") %> <%= university.english_name %></a>.</p><% } %>
        <% if (university.sourceUrls && university.sourceUrls.length) { %><p><strong><%= siteText("view.university-detail.046") %></strong></p><ul><% university.sourceUrls.forEach(function(source){ %><li><a href="<%= source %>" target="_blank" rel="noopener noreferrer"><%= source %></a></li><% }); %></ul><% } %>
        <p><strong><%= siteText("view.university-detail.047") %></strong> <%= university.updatedDateDisplay %>. <%= university.sourceNotice %></p>
      </section>
    </div>

    <aside class="knowledge-sidebar">
      <div class="knowledge-sidebar__card">
        <h2><%= siteText("view.university-detail.048") %></h2>
        <p class="section-lead"><%= siteText("view.university-detail.049") %></p>
        <a href="<%= siteText("view.university-detail.050") %>" class="btn btn-primary"><%= siteText("view.university-detail.051") %></a>
      </div>
      <div class="knowledge-sidebar__card">
        <h2><%= siteText("view.university-detail.052") %></h2>
        <p class="section-lead"><%= siteText("view.university-detail.053") %></p>
        <ul><% relatedUniversities.forEach(function(item){ %><li><a href="<%= item.url %>"><%= item.name %></a></li><% }); %></ul>
        <a href="<%= siteText("view.university-detail.054") %>" class="knowledge-card__link"><%= siteText("view.university-detail.055") %></a>
      </div>
    </aside>
  </div>
</article>
</main>
