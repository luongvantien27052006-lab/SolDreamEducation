<main>
<!-- ============ HERO ============ -->
<section class="hero">
  <div class="hero__bg"><span class="b1"></span><span class="b2"></span><span class="b3"></span></div>
  <div class="wrap">
    <div class="hero__text reveal">
      <span class="eyebrow">Tư vấn tuyển sinh du học Hàn Quốc</span>
      <h1>Học tiếng Hàn, chạm tới <span class="accent">giấc mơ du học Hàn Quốc</span></h1>
      <p class="hero__sub">Trung tâm Hàn ngữ Sol Dream Education — đào tạo tiếng Hàn cấp tốc, giao tiếp và đồng hành du học Hàn Quốc từ A–Z, cùng đội ngũ giáo viên Hàn Quốc và thạc sĩ, tiến sĩ giàu kinh nghiệm.</p>
      <div class="hero__actions">
        <a href="#lienhe" class="btn btn-primary">Đăng ký tư vấn và nhận thông tin mới nhất miễn phí
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        <a href="/khoa-hoc" class="btn btn-ghost">Xem khóa học</a>
      </div>
      <div class="hero__chips">
        <span class="chip p"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2 3 7v6c0 5 3.8 8.6 9 10 5.2-1.4 9-5 9-10V7l-9-5Z"/></svg>Giáo viên bản ngữ Hàn Quốc</span>
        <span class="chip s"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 2 2.4 7.4H22l-6 4.4 2.3 7.4L12 16.9 5.7 21.2 8 13.8l-6-4.4h7.6L12 2Z"/></svg>Học bổng du học Hàn</span>
        <span class="chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>Giao lưu văn hóa hàng tháng</span>
      </div>
    </div>

    <div class="hero__visual reveal">
      <div class="pass" role="button" tabindex="0" aria-label="Khởi động hành trình bay từ TP. Hồ Chí Minh đến Seoul" data-flight-ticket>
        <div class="pass__main">
          <div class="pass__top">
            <span class="pass__air"><i></i>SOL DREAM ✈ EDUCATION</span>
            <span class="pass__tag">Boarding Pass</span>
          </div>
          <div class="pass__route">
            <div class="pass__city"><div class="pass__code">SGN</div><small>TP. Hồ Chí Minh</small></div>
            <div class="pass__path">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 16.5 14 14V7.5a2 2 0 0 0-4 0V14l-8 2.5V19l8-1.5V22l-2 1.5V25l3-1 3 1v-1.5L12 22v-4.5L22 19v-2.5Z"/></svg>
            </div>
            <div class="pass__city"><div class="pass__code">ICN</div><small>Seoul, Hàn Quốc</small></div>
          </div>
          <div class="pass__grid">
            <div><div class="lbl">Passenger</div><div class="val">Ước mơ của bạn</div></div>
            <div><div class="lbl">Flight</div><div class="val">SD&nbsp;2026</div></div>
            <div><div class="lbl">Gate</div><div class="val">Sol Dream</div></div>
              <div><div class="lbl">Trường</div><div class="val">ĐHQG Seoul · Yonsei</div></div>
            <div><div class="lbl">Học bổng</div><div class="val">Có</div></div>
            <div><div class="lbl">Status</div><div class="val accent">Sẵn sàng</div></div>
          </div>
        </div>
        <div class="pass__stub">
          <span class="seat">HÀN QUỐC</span>
          <div class="barcode"></div>
        </div>
        <span class="pass__tap">Chạm để cất cánh</span>
      </div>
      <div class="ticket-morph" aria-hidden="true">
        <div class="ticket-morph__brand"><i></i><b>SOL DREAM</b><span>BOARDING PASS</span></div>
        <div class="ticket-morph__route"><strong>SGN</strong><i></i><strong>ICN</strong></div>
        <div class="ticket-morph__details"><span></span><span></span><span></span><span></span><span></span><span></span></div>
        <div class="ticket-morph__stub"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
      </div>
      <div class="ticket-flight" aria-hidden="true">
        <div class="ticket-flight__map">
          <img src="/img/vietnam-korea-flight-map.svg" alt="Bản đồ Việt Nam và Hàn Quốc với hành trình TP. HCM – Seoul">
          <div class="flight-map__country flight-map__country--vietnam"><b>VIỆT NAM</b><span>ĐIỂM KHỞI HÀNH</span></div>
          <div class="flight-map__country flight-map__country--korea"><b>HÀN QUỐC</b><span>ĐIỂM ĐẾN</span></div>
          <span class="flight-map__marker flight-map__marker--hcm" data-hcm-marker><i></i></span>
          <span class="flight-map__marker flight-map__marker--seoul" data-seoul-marker><i></i></span>
          <span class="flight-map__city flight-map__city--hcm">TP. HCM</span>
          <span class="flight-map__city flight-map__city--seoul">SEOUL</span>
          <div class="ticket-flight__departed"><span></span>Cất cánh từ TP. HCM</div>
          <div class="ticket-flight__landed"><span></span>Hạ cánh tại Seoul</div>
        </div>
        <span class="ticket-flight__cloud ticket-flight__cloud--one"></span>
        <span class="ticket-flight__cloud ticket-flight__cloud--two"></span>
        <svg class="ticket-flight__plane" viewBox="0 0 96 96" fill="none">
          <path d="M84 53 55 46V20c0-7-3-13-7-13s-7 6-7 13v26l-29 7v10l29-4v18l-10 7v5l17-5 17 5v-5l-10-7V59l29 4V53Z" fill="currentColor"/>
          <path d="M48 7v77" stroke="rgba(255,255,255,.55)" stroke-width="3"/>
        </svg>
      </div>
    </div>
  </div>
</section>

<!-- ============ STATS ============ -->
<% const visibleHomepageStats = typeof homepageStats !== 'undefined' ? homepageStats : []; %>
<% if (visibleHomepageStats.length) { %>
<section class="stats">
  <% const homepageStatColumns = Math.max(1, Math.min(4, visibleHomepageStats.length)); %>
  <div class="wrap" style="--stat-columns:<%= homepageStatColumns %>">
    <% visibleHomepageStats.forEach(function(stat){ %>
      <div class="stat reveal">
        <b data-count="<%= stat.value_number %>" data-prefix="<%= stat.prefix || '' %>" data-suffix="<%= stat.suffix || '' %>"><%= stat.prefix || '' %><%= Number(stat.value_number || 0).toLocaleString('vi-VN') %><%= stat.suffix || '' %></b>
        <span><%= stat.label %></span>
      </div>
    <% }) %>
    <% if (visibleHomepageStats.length && typeof homepageStatsSource !== 'undefined' && homepageStatsSource) { %><p class="stats__source"><%= homepageStatsSource %></p><% } %>
  </div>
</section>
<% } %>

<!-- ============ GIỚI THIỆU ============ -->
<section class="section about" id="gioithieu">
  <div class="wrap">
    <div class="about__visual reveal">
      <div class="about__card">
        <div class="kquote">“</div>
        <p class="k">Chúng tôi là những du học sinh Việt Nam từng học tập tại Hàn — mang khát khao đưa nền giáo dục hàng đầu châu Á đến gần hơn với học sinh Việt.</p>
        <div class="sig"><i></i><div><b style="color:#fff">Đội ngũ Sol Dream</b><br><small>Cựu du học sinh · Thạc sĩ · Tiến sĩ</small></div></div>
      </div>
      <div class="about__badge"><b>2019</b><span>Năm thành lập<br>tại TP.HCM</span></div>
    </div>
    <div class="about__body about__cms reveal">
      <% (typeof homepageAboutSections !== 'undefined' ? homepageAboutSections : []).forEach(function(section){ %>
        <% if (section.eyebrow) { %><span class="eyebrow"><%= section.eyebrow %></span><% } %>
        <h2><%= section.title %></h2>
        <%- section.content %>
      <% }) %>
    </div>
  </div>
</section>

<!-- ============ KHÓA HỌC ============ -->
<section class="section courses" id="khoahoc">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow">Khóa học tiếng Hàn</span>
      <h2>Lộ trình phù hợp cho <span class="accent">mọi mục tiêu</span></h2>
      <p class="section-lead">SOL DREAM EDUCATION có lộ trình cho người mới học Hangul, người cần luyện phản xạ giao tiếp, chỉnh phát âm hoặc tăng tốc TOPIK để chuẩn bị du học. Học viên nên chọn lớp theo trình độ hiện tại, mục tiêu sử dụng và thời gian dự kiến.</p>
    </div>
    <div class="card-grid">
      <article class="course reveal"><span class="badge-tag">Học thử miễn phí</span>
        <div class="course__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"/><circle cx="9" cy="7" r="4"/><path d="m16 11 2 2 4-4"/></svg></div>
        <h3>Tiếng Hàn giao tiếp cùng GV Hàn</h3>
        <p class="section-lead">Khóa Tiếng Hàn giao tiếp cùng giáo viên Hàn Quốc tạo môi trường luyện nói với người bản ngữ cho học viên muốn tăng phản xạ. Chương trình hiện công bố hai buổi học thử miễn phí; lịch học và điều kiện áp dụng cần được xác nhận.</p>
        <div class="course__foot"><div class="course__price">Miễn phí<small>buổi học thử</small></div><a href="/khoa-hoc/giao-tiep-giao-vien-han" class="course__link">Chi tiết <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></div>
      </article>
      <article class="course reveal">
        <div class="course__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z"/></svg></div>
        <h3>Lớp tiếng Hàn giao tiếp</h3>
        <p class="section-lead">Lớp tiếng Hàn giao tiếp dành cho người muốn tăng phản xạ nghe và nói theo các chủ đề thực tế. Chương trình hướng đến khả năng trò chuyện tự tin với người Hàn; học phí và lịch khai giảng được cung cấp khi học viên liên hệ.</p>
        <div class="course__foot"><div class="course__price">Liên hệ<small>để nhận học phí</small></div><a href="/khoa-hoc/tieng-han-giao-tiep" class="course__link">Chi tiết <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></div>
      </article>
      <article class="course reveal">
        <div class="course__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/></svg></div>
        <h3>Tiếng Hàn sơ cấp 1</h3>
        <p class="section-lead">Tiếng Hàn sơ cấp 1 phù hợp với người mới bắt đầu, tập trung bảng chữ cái Hangul, phát âm và ngữ pháp cơ bản. Mức học phí đang được website công bố là 2.020.000 đồng trọn khóa; lịch học cần xác nhận trước khi đăng ký.</p>
        <div class="course__foot"><div class="course__price">2.020.000đ<small>trọn khóa</small></div><a href="/khoa-hoc/tieng-han-so-cap-1" class="course__link">Chi tiết <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></div>
      </article>
      <article class="course reveal">
        <div class="course__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m13 2-3 7h5l-3 7"/><circle cx="12" cy="12" r="9"/></svg></div>
        <h3>Lớp tiếng Hàn cấp tốc</h3>
        <p class="section-lead">Lớp tiếng Hàn cấp tốc dành cho học viên cần tăng trình độ trong thời gian ngắn để chuẩn bị hồ sơ du học. Lộ trình tập trung mục tiêu tiếng Hàn và TOPIK; thời lượng, lịch học và học phí được tư vấn theo đợt mở lớp.</p>
        <div class="course__foot"><div class="course__price">Liên hệ<small>để nhận học phí</small></div><a href="/khoa-hoc/tieng-han-cap-toc" class="course__link">Chi tiết <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></div>
      </article>
      <article class="course reveal">
        <div class="course__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2M12 19v4M8 23h8"/></svg></div>
        <h3>Lớp phát âm chuẩn</h3>
        <p class="section-lead">Lớp phát âm tiếng Hàn tập trung chỉnh độ chính xác, độ rõ và sự tự nhiên khi nói cùng giáo viên Hàn Quốc. Khóa học phù hợp với người đã học nhưng muốn sửa lỗi phát âm; lịch học và học phí cần liên hệ xác nhận.</p>
        <div class="course__foot"><div class="course__price">Liên hệ<small>để nhận học phí</small></div><a href="/khoa-hoc/phat-am-tieng-han" class="course__link">Chi tiết <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></div>
      </article>
      <article class="course reveal" style="background:var(--ink);color:#fff;border-color:transparent">
        <div class="course__ic" style="background:rgba(255,255,255,.1);border-color:transparent"><svg viewBox="0 0 24 24" fill="none" stroke="var(--sun)" stroke-width="2"><path d="M12 2 3 7v6c0 5 3.8 8.6 9 10 5.2-1.4 9-5 9-10V7l-9-5Z"/></svg></div>
        <h3 style="color:#fff">Tiếng Anh giao tiếp</h3>
        <p class="section-lead" style="color:#b9c2d8">Lớp tiếng Anh giao tiếp dành cho học viên muốn phát triển thêm ngoại ngữ thứ hai bên cạnh tiếng Hàn. Chương trình tập trung kỹ năng giao tiếp thực tế; trình độ đầu vào, lịch mở lớp và học phí được SOL DREAM EDUCATION tư vấn khi liên hệ.</p>
        <div class="course__foot" style="border-color:rgba(255,255,255,.14)"><div class="course__price" style="color:#fff">Liên hệ<small style="color:#b9c2d8">để nhận học phí</small></div><a href="/khoa-hoc/tieng-anh-giao-tiep" class="course__link" style="color:var(--sun)">Chi tiết <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></div>
      </article>
    </div>
  </div>
</section>

<!-- ============ DU HỌC ============ -->
<section class="section duhoc" id="duhoc">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow">Du học Hàn Quốc</span>
      <h2>Hành trình sang Hàn, <span class="accent">4 bước rõ ràng</span></h2>
      <p class="section-lead">Lộ trình du học tại SOL DREAM EDUCATION gồm bốn giai đoạn: tư vấn trường ngành, học tiếng Hàn, chuẩn bị hồ sơ và visa, sau đó hỗ trợ trước khi nhập học. Chi tiết từng bước được điều chỉnh theo năng lực, ngân sách và kỳ tuyển sinh.</p>
    </div>
    <div class="journey-timeline" data-journey>
      <div class="journey-timeline__track" aria-hidden="true"><span class="journey-timeline__progress"></span><span class="journey-timeline__aircraft"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 16.5 14 14V7.5a2 2 0 0 0-4 0V14l-8 2.5V19l8-1.5V22l-2 1.5V25l3-1 3 1v-1.5L12 22v-4.5L22 19v-2.5Z"/></svg></span></div>
      <ol class="journey-timeline__list">
        <li class="journey-milestone journey-milestone--consult" style="--step-delay:.15s">
          <div class="journey-milestone__node"><span>01</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z"/></svg></div>
          <div class="journey-milestone__body"><span class="journey-milestone__label">Xác định điểm đến</span><h3>Tư vấn &amp; định hướng</h3><p>Đánh giá học lực, tiếng Hàn, ngân sách và mục tiêu nghề nghiệp để lập danh sách trường, ngành và học bổng cần kiểm tra.</p><small>Trường · Ngành · Ngân sách</small></div>
        </li>
        <li class="journey-milestone journey-milestone--study" style="--step-delay:.7s">
          <div class="journey-milestone__node"><span>02</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2Z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7Z"/></svg></div>
          <div class="journey-milestone__body"><span class="journey-milestone__label">Xây nền tảng</span><h3>Học tiếng Hàn</h3><p>Xây nền tảng hoặc tăng tốc tới mục tiêu TOPIK phù hợp với chương trình, thời gian chuẩn bị và yêu cầu của trường.</p><small>Hangul · Giao tiếp · TOPIK</small></div>
        </li>
        <li class="journey-milestone journey-milestone--visa" style="--step-delay:1.25s">
          <div class="journey-milestone__node"><span>03</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6M9 15l2 2 4-4"/></svg></div>
          <div class="journey-milestone__body"><span class="journey-milestone__label">Sẵn sàng hồ sơ</span><h3>Hồ sơ &amp; Visa</h3><p>Rà soát giấy tờ học tập, tài chính và chuẩn bị phỏng vấn theo yêu cầu cập nhật của trường và cơ quan có thẩm quyền.</p><small>Giấy tờ · Tài chính · Phỏng vấn</small></div>
        </li>
        <li class="journey-milestone journey-milestone--flight" style="--step-delay:1.8s">
          <div class="journey-milestone__node"><span>04</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.5 14 14V7.5a2 2 0 0 0-4 0V14l-8 2.5V19l8-1.5V22l-2 1.5V25l3-1 3 1v-1.5L12 22v-4.5L22 19v-2.5Z"/></svg></div>
          <div class="journey-milestone__body"><span class="journey-milestone__label">Cất cánh</span><h3>Lên đường sang Hàn</h3><p>Chuẩn bị nhập cảnh, chỗ ở và thủ tục nhập học theo kế hoạch đã thống nhất với học viên trước ngày khởi hành.</p><small>Nhập cảnh · Chỗ ở · Nhập học</small></div>
        </li>
      </ol>
      <div class="journey-timeline__destination" aria-hidden="true"><span>SGN</span><i></i><span>ICN</span></div>
    </div>
    <h2 class="reveal" style="text-align:center;font-size:clamp(24px,3.4vw,36px);margin:8px 0 34px">Trường đại học &amp; chương trình du học nổi bật</h2>
    <p class="section-lead reveal" style="text-align:center;max-width:760px;margin:-18px auto 34px">Danh sách nổi bật giới thiệu các trường và chủ đề du học đang có trên website SOL DREAM EDUCATION. Mỗi thẻ dẫn đến trang chi tiết; điều kiện đầu vào, học phí, ngành tuyển và học bổng cần được đối chiếu theo kỳ tuyển sinh.</p>
    <div class="news-grid">
      <% programs.forEach(function(pr){ %>
      <a class="post reveal" href="<%= pr.category==='Thông tin trường'?'/truong-dai-hoc/':'/du-hoc/' %><%= pr.slug %>">
        <div class="post__img <%= pr.cover_image ? '' : pr.cover %>">
          <img class="post__cover<%= (!pr.cover_image || pr.cover_image === '/img/research-cover.svg') ? ' post__cover--fallback' : '' %>" src="<%= pr.cover_image || '/img/research-cover.svg' %>" alt="<%= pr.title %>" loading="lazy">
        </div>
        <div class="post__body"><span class="post__cat"><%= pr.category %></span>
          <h3><%= pr.title %></h3>
          <p class="section-lead"><%= pr.geoBluf %></p>
          <% if (pr.subtitle) { %><div class="prog__kr"><%= pr.subtitle %></div><% } %>
        </div>
      </a>
      <% }); %>
    </div>
    <% if (programs && programs.length) { %>
    <div style="text-align:center;margin-top:40px">
      <a href="/du-hoc" class="btn btn-ghost">Xem tất cả chương trình du học
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="width:18px;height:18px"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </div>
    <% } %>
  </section>

<!-- ============ VÌ SAO CHỌN ============ -->
<section class="section why">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow" style="color:var(--sun)">Vì sao chọn Sol Dream</span>
      <h2>Không chỉ dạy tiếng — <span style="color:var(--sun)">chắp cánh tương lai</span></h2>
      <p class="section-lead">SOL DREAM EDUCATION công bố sáu nhóm giá trị trong trải nghiệm học viên: đội ngũ giáo viên, giao lưu văn hóa, định hướng học bổng, cơ sở học tập, kinh nghiệm của nhân sự và hỗ trợ xuyên suốt lộ trình học tiếng đến nhập học.</p>
    </div>
    <div class="why-grid">
      <div class="feat reveal"><div class="feat__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10 12 5 2 10l10 5 10-5Z"/><path d="M6 12v5c0 1 3 3 6 3s6-2 6-3v-5"/></svg></div><h3>Giáo viên chất lượng</h3><p class="section-lead">Theo thông tin trung tâm công bố, đội ngũ giảng dạy gồm giáo viên Hàn Quốc bản ngữ và nhân sự cốt lõi có trình độ thạc sĩ, tiến sĩ. Sự phù hợp của lớp vẫn cần được đánh giá theo trình độ và mục tiêu từng học viên.</p></div>
      <div class="feat reveal"><div class="feat__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20Z"/></svg></div><h3>Giao lưu văn hóa</h3><p class="section-lead">SOL DREAM EDUCATION giới thiệu hoạt động giao lưu văn hóa Hàn Quốc như một phần của môi trường học tập. Hoạt động giúp học viên tiếp cận ngôn ngữ trong bối cảnh thực tế; chủ đề và lịch tổ chức cần được xác nhận theo từng tháng.</p></div>
      <div class="feat reveal"><div class="feat__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 2 2.4 7.4H22l-6 4.4 2.3 7.4L12 16.9 5.7 21.2 8 13.8l-6-4.4h7.6L12 2Z"/></svg></div><h3>Săn học bổng</h3><p class="section-lead">Dịch vụ định hướng học bổng hỗ trợ học viên tìm chương trình phù hợp và chuẩn bị hồ sơ theo năng lực. Học bổng phụ thuộc tiêu chí, ngân sách và kỳ tuyển sinh của từng trường; nội dung tư vấn không phải cam kết học viên sẽ được cấp.</p></div>
      <div class="feat reveal"><div class="feat__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg></div><h3>Cơ sở hiện đại</h3><p class="section-lead">Trung tâm công bố có không gian học tập và trang thiết bị phục vụ đào tạo tại quận Tân Phú, TP.HCM. Người quan tâm có thể đến địa chỉ 89 đường S11 để tìm hiểu trực tiếp về phòng học, lịch lớp và điều kiện học tập.</p></div>
      <div class="feat reveal"><div class="feat__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/></svg></div><h3>Đội ngũ trẻ &amp; nhiệt huyết</h3><p class="section-lead">Theo giới thiệu của trung tâm, đội ngũ có cựu du học sinh Việt Nam từng học tập tại Hàn Quốc. Kinh nghiệm này được dùng để hỗ trợ học viên hình dung quá trình học tiếng, chuẩn bị hồ sơ và thích nghi trước kỳ nhập học.</p></div>
      <div class="feat reveal"><div class="feat__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m22 4-10 10.01L9 11"/></svg></div><h3>Đồng hành trọn gói</h3><p class="section-lead">SOL DREAM EDUCATION định hướng hỗ trợ từ lựa chọn khóa tiếng Hàn, trường và ngành đến chuẩn bị hồ sơ và nhập học. Phạm vi công việc, thời gian và chi phí cụ thể cần được thống nhất theo chương trình dịch vụ và hồ sơ của học viên.</p></div>
    </div>
  </div>
</section>

<!-- ============ CẢM NHẬN ============ -->
<section class="section tmn" id="cam-nhan-hoc-vien">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow">Cảm nhận học viên</span>
      <h2>Học viên nói gì về <span class="accent">Sol Dream</span></h2>
      <p class="section-lead">Các phản hồi dưới đây là lời chia sẻ do SOL DREAM EDUCATION tuyển chọn và công bố từ học viên đã tham gia học hoặc chuẩn bị du học. Đây là trải nghiệm cá nhân, không phải hệ thống đánh giá độc lập và không bảo đảm kết quả giống nhau.</p>
    </div>
    <div class="tmn-grid">
      <% (testimonials || []).forEach(function(item){ %>
      <article class="tcard reveal">
        <div class="stars" aria-label="<%= item.rating %> trên 5 sao">
          <% for (let star = 0; star < item.rating; star += 1) { %><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2 2.4 7.4H22l-6 4.4 2.3 7.4L12 16.9 5.7 21.2 8 13.8l-6-4.4h7.6L12 2Z"/></svg><% } %>
        </div>
        <blockquote>“<%= item.quote %>”</blockquote>
        <div class="who">
          <% if (item.avatar_image) { %><img src="<%= item.avatar_image %>" alt="Ảnh đại diện <%= item.name %>" loading="lazy"><% } else { %><i><%= item.initials || 'SD' %></i><% } %>
          <div><b><%= item.name %></b><small><%= item.role %></small></div>
        </div>
      </article>
      <% }); %>
    </div>
    <p class="testimonial-source">Phản hồi học viên do SOL DREAM EDUCATION tuyển chọn và công bố; đây không phải hệ thống đánh giá độc lập.</p>
  </div>
</section>

<!-- ============ TIN TỨC ============ -->
<section class="section news" id="tintuc">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow">Cẩm nang du học</span>
      <h2>Cẩm nang &amp; câu chuyện <span class="accent">du học Hàn</span></h2>
      <p class="section-lead">Cẩm nang của SOL DREAM EDUCATION hỗ trợ học viên học tiếng, chọn trường, chuẩn bị hồ sơ và thích nghi với đời sống Hàn Quốc. Các thông tin dễ thay đổi như visa, chi phí và tuyển sinh sẽ được chuyên viên xác nhận theo thời điểm và hồ sơ cụ thể.</p>
    </div>
    <div class="news-grid">
      <% posts.forEach(function(p){ %>
      <a class="post reveal" href="/tin-tuc/<%= p.slug %>">
        <div class="post__img <%= p.cover_image ? '' : p.cover %>">
          <img class="post__cover<%= (!p.cover_image || p.cover_image === '/img/research-cover.svg') ? ' post__cover--fallback' : '' %>" src="<%= p.cover_image || '/img/research-cover.svg' %>" alt="<%= p.title %>" loading="lazy">
          <div class="post__date"><b><%= p.day %></b><span><%= p.monthYear %></span></div>
        </div>
        <div class="post__body"><span class="post__cat"><%= p.category %></span>
          <h3><%= p.title %></h3>
          <p class="section-lead"><%= p.geoBluf %></p>
        </div>
      </a>
      <% }); %>
      <% if (posts.length === 0) { %><p>Chưa có bài viết nào.</p><% } %>
    </div>
    <div style="text-align:center;margin-top:40px">
      <a href="/tin-tuc" class="btn btn-ghost">Xem tất cả tin tức
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="width:18px;height:18px"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </div>
  </div>
</section>

<!-- ============ CTA / LIÊN HỆ ============ -->
<section class="section cta" id="lienhe">
  <div class="wrap reveal">
    <div class="cta__left">
      <span class="eyebrow">Đăng ký tư vấn</span>
      <h2>Bắt đầu hành trình Hàn Quốc của bạn ngay hôm nay</h2>
      <p class="section-lead">Để lại thông tin để được tư vấn lộ trình phù hợp và nhận thông báo mới nhất về khóa học, chương trình du học hoặc trường đại học Hàn Quốc.</p>
      <div class="cta__contacts">
        <a href="tel:0364648282"><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.94.36 1.86.68 2.75a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.33-1.33a2 2 0 0 1 2.11-.45c.89.32 1.81.55 2.75.68A2 2 0 0 1 22 16.92Z"/></svg></i><div>Hotline<br><b>0364 648 282</b></div></a>
        <a href="mailto:soldream.edu@gmail.com"><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 6 10 7 10-7"/></svg></i><div>Email<br><b style="font-size:15px">soldream.edu@gmail.com</b></div></a>
      </div>
    </div>
    <form class="cta__form" id="consultationForm" data-lead-form>
      <h3>Đăng ký tư vấn và nhận thông tin mới nhất miễn phí</h3>
      <p class="section-lead">SOL DREAM EDUCATION sẽ liên hệ theo thông tin bạn cung cấp. Việc gửi biểu mẫu chưa phải đăng ký khóa học hay cam kết dịch vụ.</p>
      <div class="field"><label for="ten">Họ và tên</label><input id="ten" name="name" type="text" autocomplete="name" minlength="2" maxlength="100" required placeholder="Nguyễn Văn A"></div>
      <div class="field"><label for="sdt">Số điện thoại</label><input id="sdt" name="phone" type="tel" inputmode="tel" autocomplete="tel" minlength="9" maxlength="20" required placeholder="09xx xxx xxx"></div>
      <div class="field"><label for="email">Email liên hệ</label><input id="email" name="email" type="email" autocomplete="email" maxlength="180" required placeholder="ban@example.com"></div>
      <div class="field"><label for="kh">Bạn quan tâm</label>
        <select id="kh" name="interest" data-interest-select>
          <option>Tiếng Hàn giao tiếp</option>
          <option>Tiếng Hàn cấp tốc</option>
          <option>Tiếng Hàn sơ cấp / trung cấp</option>
          <option>Du học Hàn Quốc</option>
          <option>Thông tin trường</option>
        </select>
      </div>
      <div class="field" data-interest-detail-field hidden>
        <label for="interest-detail" data-interest-detail-label>Thông tin bạn muốn nhận</label>
        <input id="interest-detail" name="interestDetail" type="text" maxlength="240" data-interest-detail placeholder="Nhập nội dung bạn muốn được tư vấn">
      </div>
      <div class="field hp-field" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div>
      <input type="hidden" name="formStartedAt" value="">
      <button class="btn btn-primary" type="submit" style="justify-content:center;width:100%" data-lead-submit>Gửi đăng ký</button>
      <p class="form-note" data-lead-status role="status" aria-live="polite"></p>
      <p class="form-note">Bằng việc gửi, bạn đồng ý được Sol Dream liên hệ tư vấn và gửi email khi có thông tin mới đúng với nội dung đã đăng ký.</p>
    </form>
  </div>
</section>
</main>
