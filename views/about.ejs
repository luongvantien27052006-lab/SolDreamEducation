<main>
<article class="section knowledge-hub">
  <div class="wrap" style="max-width:920px">
    <nav class="crumbs" aria-label="breadcrumb"><a href="/">Trang chủ</a> <span>›</span> <span>Giới thiệu</span></nav>
    <header class="knowledge-hero">
      <span class="eyebrow">Về chúng tôi</span>
      <h1>SOL DREAM EDUCATION là ai?</h1>
      <p>SOL DREAM EDUCATION là trung tâm Hàn ngữ và tư vấn du học Hàn Quốc tại Tân Phú, TP.HCM, hoạt động từ năm 2019 với định hướng đào tạo ngoại ngữ và đồng hành hồ sơ du học.</p>
      <div class="source-meta"><strong>Thông tin do:</strong> SOL DREAM EDUCATION công bố · <strong>Cập nhật:</strong> 25/09/2026</div>
    </header>

    <% const tabSections = (aboutSections || []).filter(function(section){ return section.section_style === 'tab'; }); %>
    <% const regularSections = (aboutSections || []).filter(function(section){ return section.section_style !== 'tab'; }); %>
    <% if (tabSections.length) { %>
      <section class="about-tabs" data-about-tabs aria-label="Nội dung giới thiệu SOL DREAM EDUCATION">
        <div class="about-tabs__list" role="tablist" aria-label="Các mục giới thiệu">
          <% tabSections.forEach(function(section, index){ %>
            <button class="about-tabs__tab<%= index === 0 ? ' is-active' : '' %>" type="button" role="tab" id="about-tab-button-<%= section.id %>" aria-controls="about-tab-panel-<%= section.id %>" aria-selected="<%= index === 0 ? 'true' : 'false' %>" tabindex="<%= index === 0 ? '0' : '-1' %>" data-about-tab-target="about-tab-panel-<%= section.id %>"><%= section.title %></button>
          <% }); %>
        </div>
        <div class="about-tabs__panels">
          <% tabSections.forEach(function(section, index){ %>
            <section class="about-tabs__panel<%= index === 0 ? ' is-active' : '' %><%= section.title === 'Bộ máy tổ chức' ? ' about-tabs__panel--organization' : '' %>" id="about-tab-panel-<%= section.id %>" role="tabpanel" tabindex="0" aria-labelledby="about-tab-button-<%= section.id %>">
              <% if (section.eyebrow) { %><span class="eyebrow"><%= section.eyebrow %></span><% } %>
              <h2><%= section.title %></h2>
              <div class="about-tabs__content"><%- section.content %></div>
            </section>
          <% }); %>
        </div>
      </section>
    <% } %>

    <% regularSections.forEach(function(section){ %>
      <% if (section.section_style === 'direct-answer') { %>
        <section class="direct-answer" aria-labelledby="about-section-<%= section.id %>">
          <p class="direct-answer__label"><%= section.eyebrow || 'Trả lời nhanh' %></p>
          <h2 id="about-section-<%= section.id %>" class="sr-only"><%= section.title %></h2>
          <%- section.content %>
        </section>
      <% } else { %>
        <section class="<%= section.section_style === 'source-box' ? 'source-box' : 'knowledge-section' %>" aria-labelledby="about-section-<%= section.id %>">
          <% if (section.eyebrow) { %><span class="eyebrow"><%= section.eyebrow %></span><% } %>
          <h2 id="about-section-<%= section.id %>"><%= section.title %></h2>
          <%- section.content %>
        </section>
      <% } %>
    <% }) %>
  </div>
</article>
</main>
