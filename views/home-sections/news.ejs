<!-- ============ TIN TỨC ============ -->
<section class="section news" id="tintuc">
  <div class="wrap">
    <div class="sec-head reveal"><%- include("../partials/shared-block", { blockKey: "news-intro" }) %></div>
    <nav class="topic-tabs" aria-label="<%= siteText("view.home-sections.news.001") %>">
      <a href="<%= siteText("view.home-sections.news.002") %>"><%= siteText("view.home-sections.news.003") %></a>
      <a href="<%= siteText("view.home-sections.news.004") %>"><%= siteText("view.home-sections.news.005") %></a>
      <a href="<%= siteText("view.home-sections.news.006") %>"><%= siteText("view.home-sections.news.007") %></a>
    </nav>
    <div class="news-grid">
      <% posts.forEach(function(p){ %>
      <a class="post reveal" href="/tin-tuc/<%= p.slug %>">
        <div class="post__img <%= p.cover_image ? '' : p.cover %>">
          <img class="post__cover<%= (!p.cover_image || p.cover_image === '/img/research-cover.svg') ? ' post__cover--fallback' : '' %>" <%- imageAttributes(p.cover_image || '/img/research-cover.svg', '(max-width: 720px) 100vw, 420px') %> alt="<%= p.title %>" loading="lazy">
          <div class="post__date"><b><%= p.day %></b><span><%= p.monthYear %></span></div>
        </div>
        <div class="post__body"><span class="post__cat"><%= p.topicLabel %></span>
          <h3><%= p.title %></h3>
          <p class="section-lead"><%= p.geoBluf %></p>
        </div>
      </a>
      <% }); %>
      <% if (posts.length === 0) { %><p><%= siteText("view.home-sections.news.008") %></p><% } %>
    </div>
    <div style="text-align:center;margin-top:40px">
      <a href="<%= siteText("view.home-sections.news.009") %>" class="btn btn-ghost"><%= siteText("view.home-sections.news.010") %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="width:18px;height:18px"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </div>
  </div>
</section>

