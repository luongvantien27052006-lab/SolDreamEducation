<!-- ============ DU HỌC ============ -->
<section class="section duhoc" id="duhoc">
  <div class="wrap">
    <div class="sec-head reveal"><%- include("../partials/shared-block", { blockKey: "journey-intro" }) %></div>
    <div class="journey-timeline" data-journey>
      <div class="journey-timeline__track" aria-hidden="true"><span class="journey-timeline__progress"></span><span class="journey-timeline__aircraft"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 16.5 14 14V7.5a2 2 0 0 0-4 0V14l-8 2.5V19l8-1.5V22l-2 1.5V25l3-1 3 1v-1.5L12 22v-4.5L22 19v-2.5Z"/></svg></span></div>
      <ol class="journey-timeline__list">
        <li class="journey-milestone journey-milestone--consult" style="--step-delay:.15s">
          <div class="journey-milestone__node"><span><%= siteText("view.home-sections.journey.001") %></span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z"/></svg></div>
          <div class="journey-milestone__body"><span class="journey-milestone__label"><%= siteText("view.home-sections.journey.002") %></span><h3><%= siteText("view.home-sections.journey.003") %></h3><p><%= siteText("view.home-sections.journey.004") %></p><small><%= siteText("view.home-sections.journey.005") %></small></div>
        </li>
        <li class="journey-milestone journey-milestone--study" style="--step-delay:.7s">
          <div class="journey-milestone__node"><span><%= siteText("view.home-sections.journey.006") %></span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2Z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7Z"/></svg></div>
          <div class="journey-milestone__body"><span class="journey-milestone__label"><%= siteText("view.home-sections.journey.007") %></span><h3><%= siteText("view.home-sections.journey.008") %></h3><p><%= siteText("view.home-sections.journey.009") %></p><small><%= siteText("view.home-sections.journey.010") %></small></div>
        </li>
        <li class="journey-milestone journey-milestone--visa" style="--step-delay:1.25s">
          <div class="journey-milestone__node"><span><%= siteText("view.home-sections.journey.011") %></span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6M9 15l2 2 4-4"/></svg></div>
          <div class="journey-milestone__body"><span class="journey-milestone__label"><%= siteText("view.home-sections.journey.012") %></span><h3><%= siteText("view.home-sections.journey.013") %></h3><p><%= siteText("view.home-sections.journey.014") %></p><small><%= siteText("view.home-sections.journey.015") %></small></div>
        </li>
        <li class="journey-milestone journey-milestone--flight" style="--step-delay:1.8s">
          <div class="journey-milestone__node"><span><%= siteText("view.home-sections.journey.016") %></span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.5 14 14V7.5a2 2 0 0 0-4 0V14l-8 2.5V19l8-1.5V22l-2 1.5V25l3-1 3 1v-1.5L12 22v-4.5L22 19v-2.5Z"/></svg></div>
          <div class="journey-milestone__body"><span class="journey-milestone__label"><%= siteText("view.home-sections.journey.017") %></span><h3><%= siteText("view.home-sections.journey.018") %></h3><p><%= siteText("view.home-sections.journey.019") %></p><small><%= siteText("view.home-sections.journey.020") %></small></div>
        </li>
      </ol>
      <div class="journey-timeline__destination" aria-hidden="true"><span><%= siteText("view.home-sections.journey.021") %></span><i></i><span><%= siteText("view.home-sections.journey.022") %></span></div>
    </div>
    <% const schoolsIntro = getBlock('school-featured-intro'); if (schoolsIntro.active) { %>
    <h2 class="reveal" style="text-align:center;font-size:clamp(24px,3.4vw,36px);margin:8px 0 34px"><%= schoolsIntro.title %></h2>
    <div class="section-lead reveal" style="text-align:center;max-width:760px;margin:-18px auto 34px"><%- schoolsIntro.content %></div>
    <% } %>
    <div class="news-grid">
      <% programs.forEach(function(pr){ %>
      <a class="post reveal" href="<%= pr.category==='Thông tin trường'?'/truong-dai-hoc/':'/du-hoc/' %><%= pr.slug %>">
        <div class="post__img <%= pr.cover_image ? '' : pr.cover %>">
          <img class="post__cover<%= (!pr.cover_image || pr.cover_image === '/img/research-cover.svg') ? ' post__cover--fallback' : '' %>" src="<%= pr.cover_image || '/img/research-cover.svg' %>" alt="<%= pr.title %>" loading="lazy">
        </div>
        <div class="post__body"><span class="post__cat"><%= pr.categoryLabel %></span>
          <h3><%= pr.title %></h3>
          <p class="section-lead"><%= pr.geoBluf %></p>
          <% if (pr.subtitle) { %><div class="prog__kr"><%= pr.subtitle %></div><% } %>
        </div>
      </a>
      <% }); %>
    </div>
    <% if (programs && programs.length) { %>
    <div style="text-align:center;margin-top:40px">
      <a href="<%= siteText("view.home-sections.journey.023") %>" class="btn btn-ghost"><%= siteText("view.home-sections.journey.024") %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="width:18px;height:18px"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </div>
    <% } %>
  </section>

