<main class="chat-page">
  <div class="wrap chat-page__layout">
    <section class="chat-page__shell" data-chat-interface aria-labelledby="chatbot-title">
      <header class="chatbot__header">
        <a class="chatbot__back" href="<%= siteText("view.chat-page.001") %>" aria-label="<%= siteText("view.chat-page.002") %>">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        </a>
        <div class="chatbot__avatar" aria-hidden="true"><img src="/img/soldream-robot.png?v=sde3" alt=""></div>
        <div class="chatbot__identity">
          <h1 id="chatbot-title"><%= siteText("view.chat-page.003") %><span class="chatbot__seo-title"> <%= siteText("view.chat-page.004") %></span></h1>
          <span class="chatbot__status" role="status"><i aria-hidden="true"></i> <span><%= siteText("view.chat-page.005") %></span></span>
        </div>
        <button class="chatbot__new" type="button" aria-label="<%= siteText("view.chat-page.006") %>" title="<%= siteText("view.chat-page.007") %>">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        </button>
        <a class="chatbot__advisor" href="<%= siteText("view.chat-page.008") %>" target="_blank" rel="noopener noreferrer" aria-label="<%= siteText("view.chat-page.009") %>">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15.5a3.5 3.5 0 0 1-3.5 3.5h-11L3 21v-5.5A3.5 3.5 0 0 1 2 13V6.5A3.5 3.5 0 0 1 5.5 3h12A3.5 3.5 0 0 1 21 6.5Z"/><path d="M7 8h10M7 12h7"/></svg>
          <span><%= siteText("view.chat-page.010") %></span>
        </a>
      </header>

      <div class="chatbot__messages" aria-live="polite" aria-label="<%= siteText("view.chat-page.011") %>">
        <div class="chatbot__day"><span><%= siteText("view.chat-page.012") %></span></div>
        <div class="chatbot__message-row chatbot__message-row--bot">
          <div class="chatbot__mini-avatar" aria-hidden="true"><img src="/img/soldream-robot.png?v=sde3" alt=""></div>
          <div class="chatbot__message chatbot__message--bot"><p><%= siteText('browser.chatbot.001') %></p></div>
        </div>
      </div>

      <div class="chatbot__quick-questions" aria-label="<%= siteText("view.chat-page.014") %>">
        <button type="button"><%= siteText("view.chat-page.015") %></button>
        <button type="button"><%= siteText("view.chat-page.016") %></button>
        <button type="button"><%= siteText("view.chat-page.017") %></button>
        <button type="button"><%= siteText("view.chat-page.018") %></button>
      </div>

      <form class="chatbot__form">
        <div class="chatbot__composer">
          <textarea id="chatbot-input" class="chatbot__input" name="message" rows="1" maxlength="1500" autocomplete="off" enterkeyhint="send" aria-label="<%= siteText("view.chat-page.019") %>" placeholder="<%= siteText("view.chat-page.020") %>"></textarea>
        </div>
        <button class="chatbot__send" type="submit" aria-label="<%= siteText("view.chat-page.021") %>">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21 3-7.7 18-2.8-7.2L3 11l18-8Z"/><path d="m10.5 13.8 4.1-4.1"/></svg>
        </button>
      </form>
    </section>
  </div>
</main>
