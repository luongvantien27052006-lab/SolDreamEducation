<main>
<section class="section knowledge-hub">
  <div class="wrap">
    <nav class="crumbs" aria-label="<%= siteText("view.universities-list.001") %>">
      <a href="<%= siteText("view.universities-list.002") %>"><%= siteText("view.universities-list.003") %></a> <span>›</span> <span><%= siteText("view.universities-list.004") %></span>
    </nav>
    <header class="knowledge-hero">
      <span class="eyebrow"><%= siteText("view.universities-list.005") %></span>
      <h1><%= siteText("view.universities-list.006") %></h1>
      <p><%= siteText("view.universities-list.007") %></p>
      <div class="source-meta"><strong><%= siteText("view.universities-list.008") %></strong> <%= siteText("view.universities-list.009") %> <strong><%= siteText("view.universities-list.010") %></strong> <%= siteText("view.universities-list.011") %></div>
    </header>

    <section aria-labelledby="partner-schools-title">
      <h2 id="partner-schools-title" style="margin:36px 0 10px"><%= siteText("view.universities-list.012") %></h2>
      <p class="section-lead"><%= siteText("view.universities-list.013") %></p>
      <p><a class="knowledge-card__link" href="<%= siteText("view.universities-list.014") %>"><%= siteText("view.universities-list.015") %></a></p>
      <div class="knowledge-grid">
        <% partnerSchools.forEach(function(school){ %>
        <article class="knowledge-card">
          <div class="knowledge-card__top"><span><%= school.type %></span><span><%= school.campus %></span></div>
          <h3><%= school.name %></h3>
          <p class="knowledge-card__en"><%= school.englishName %></p>
          <div style="display:flex;flex-wrap:wrap;gap:0 16px">
            <% if (school.profilePath) { %><a class="knowledge-card__link" style="margin-top:12px" href="<%= school.profilePath %>"><%= siteText("view.universities-list.016") %></a><% } %>
            <a class="knowledge-card__link" style="margin-top:12px" href="<%= school.website %>" target="_blank" rel="noopener noreferrer"><%= siteText("view.universities-list.017") %></a>
          </div>
        </article>
        <% }); %>
      </div>
    </section>

    <% if (schoolPrograms && schoolPrograms.length) { %>
    <section aria-labelledby="admin-school-title">
      <h2 id="admin-school-title" style="margin:36px 0 20px"><%= siteText("view.universities-list.018") %></h2>
      <div class="news-grid">
        <% schoolPrograms.forEach(function(program){ %>
        <a class="post" href="/truong-dai-hoc/<%= program.slug %>">
          <div class="post__img <%= program.cover_image ? '' : program.cover %>"><img class="post__cover<%= (!program.cover_image || program.cover_image === '/img/research-cover.svg') ? ' post__cover--fallback' : '' %>" src="<%= program.cover_image || '/img/research-cover.svg' %>" alt="<%= program.title %>" loading="lazy"></div>
          <div class="post__body"><span class="post__cat"><%= siteText("view.universities-list.019") %></span><h3><%= program.title %></h3><p class="section-lead"><%= program.geoBluf %></p><% if(program.subtitle){ %><div class="prog__kr"><%= program.subtitle %></div><% } %></div>
        </a>
        <% }); %>
      </div>
    </section>
    <% } %>

    <% if (universities.length) { %><h2 style="margin:42px 0 20px"><%= siteText("view.universities-list.020") %></h2><% } %>
    <div class="knowledge-grid">
      <% universities.forEach(function(university){ %>
      <article class="knowledge-card">
        <div class="knowledge-card__top"><span><%= university.english_name %></span><span><%= university.location_terms[0] %></span></div>
        <h2><a href="<%= university.url %>"><%= university.name %></a></h2>
        <p class="section-lead"><%= university.bluf %></p>
        <p class="knowledge-card__en"><%= university.english_name %></p>
        <p><%= university.highlight %></p>
        <% if (university.tuitionSummary) { %><p class="knowledge-card__fact"><strong><%= siteText("view.universities-list.021") %></strong> <%= university.tuitionSummary %></p><% } %>
        <a class="knowledge-card__link" href="<%= university.url %>"><%= siteText("view.universities-list.022") %></a>
      </article>
      <% }); %>
    </div>

    <section class="source-box dataset-scope" aria-labelledby="dataset-title">
      <h2 id="dataset-title"><%= siteText("view.universities-list.023") %></h2>
      <p class="section-lead"><%= siteText("view.universities-list.024") %> <%= partnerSchools.length %> <%= siteText("view.universities-list.025") %> <%= universities.length + schoolPrograms.length %> <%= siteText("view.universities-list.026") %></p>
      <ul>
        <li><strong><%= siteText("view.universities-list.027") %></strong> <%= partnerSchools.map(function(item){ return item.name; }).join('; ') %>.</li>
        <li><strong><%= siteText("view.universities-list.028") %></strong> <%= schoolPrograms.map(function(item){ return item.title; }).concat(universities.map(function(item){ return item.name; })).join('; ') %>.</li>
        <li><strong><%= siteText("view.universities-list.029") %></strong> <%= siteText("view.universities-list.030") %></li>
        <li><strong><%= siteText("view.universities-list.031") %></strong> <%= siteText("view.universities-list.032") %></li>
      </ul>
    </section>

    <aside class="source-note">
      <strong><%= siteText("view.universities-list.033") %></strong> <%= siteText("view.universities-list.034") %>
    </aside>
  </div>
</section>
</main>
