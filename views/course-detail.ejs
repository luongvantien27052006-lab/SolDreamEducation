<main>
<article class="section knowledge-hub">
  <div class="wrap" style="max-width:920px">
    <nav class="crumbs" aria-label="<%= siteText("view.course-detail.001") %>"><a href="<%= siteText("view.course-detail.002") %>"><%= siteText("view.course-detail.003") %></a> <span>›</span> <a href="<%= siteText("view.course-detail.004") %>"><%= siteText("view.course-detail.005") %></a> <span>›</span> <span><%= course.name %></span></nav>
    <header class="knowledge-hero">
      <span class="eyebrow"><%= course.language %></span>
      <h1><%= course.name %></h1>
      <div class="geo-summary-box">
        <p class="geo-summary-box__bluf"><%= course.blufSummary %></p>
        <ul class="geo-summary-box__facts">
          <li><strong><%= siteText("view.course-detail.006") %></strong> <%= course.audience %></li>
          <li><strong><%= siteText("view.course-detail.007") %></strong> <%= course.price %></li>
          <li><strong><%= siteText("view.course-detail.008") %></strong> <%= course.requirements.entryLevel || siteText("view.course-detail.054") %></li>
          <li><strong><%= course.entryExamLabel %>:</strong> <%= course.entryExamRequirement || siteText("view.course-detail.055") %></li>
        </ul>
      </div>
    </header>
    <%- include('partials/course-information') %>
    <%- include('partials/content-responsibility',{item:course,kind:'course'}) %>
    <section class="faq-section" aria-labelledby="course-faq-title">
      <h2 id="course-faq-title"><%= siteText("view.course-detail.044") %> <%= course.name %></h2>
      <% courseFaqs.forEach(function(faq, index){ %><details class="faq-item" <%= index === 0 ? 'open' : '' %>><summary><%= faq.question %></summary><p class="section-lead"><%= faq.answer %></p></details><% }); %>
    </section>
    <% if (/tiếng anh|english/i.test(`${course.language || ''} ${course.name || ''}`)) { %>
      <aside class="recruitment-callout" aria-labelledby="recruitment-callout-title">
        <img class="recruitment-callout__image" src="/img/tuyen-dung-giao-vien-tieng-anh-v2.png" alt="<%= siteText("view.course-detail.045") %>">
        <div class="recruitment-callout__body">
          <span class="eyebrow"><%= siteText("view.course-detail.046") %></span>
          <h2 id="recruitment-callout-title"><%= siteText("view.course-detail.047") %></h2>
          <p><%= siteText("view.course-detail.048") %></p>
          <a class="btn btn-primary" href="<%= siteText("view.course-detail.049") %>"><%= siteText("view.course-detail.050") %></a>
        </div>
      </aside>
    <% } %>
    <aside class="source-note"><strong><%= siteText("view.course-detail.051") %></strong> <%= courseNotice %></aside>
    <p style="margin-top:28px"><a href="<%= siteText("view.course-detail.052") %>" class="btn btn-primary"><%= siteText("view.course-detail.053") %></a></p>
  </div>
</article>
</main>
