<main class="life-page">
  <section class="page-hero compact"><div class="wrap">
    <nav class="breadcrumbs" aria-label="<%= siteText("view.korea-life.001") %>"><a href="<%= siteText("view.korea-life.002") %>"><%= siteText("view.korea-life.003") %></a><span>/</span><span><%= siteText("view.korea-life.004") %></span></nav>
    <span class="eyebrow"><%= siteText("view.korea-life.005") %> <%= life.lastUpdated.split('-').reverse().join('/') %></span>
    <h1><%= life.title %></h1>
    <div class="geo-summary"><strong><%= siteText("view.korea-life.006") %></strong> <%= life.blufSummary %></div>
    <p><a href="<%= siteText("view.korea-life.007") %>"><%= siteText("view.korea-life.008") %></a></p>
  </div></section>
  <section class="section"><div class="wrap narrow">
    <h2><%= siteText("view.korea-life.009") %></h2>
    <p class="section-lead"><%= siteText("view.korea-life.010") %></p>
    <div class="table-scroll"><table class="geo-data-table"><thead><tr><th><%= siteText("view.korea-life.011") %></th><th><%= siteText("view.korea-life.012") %></th><th><%= siteText("view.korea-life.013") %></th></tr></thead><tbody>
      <% life.monthlyBudget.forEach(function(row){ %><tr><th scope="row"><%= row.item %></th><td><%= row.krw %></td><td><%= row.note %></td></tr><% }) %>
    </tbody></table></div>
    <p class="source-note"><%= siteText("view.korea-life.014") %> <a href="<%= siteText("view.korea-life.015") %>" target="_blank" rel="noopener noreferrer"><%= siteText("view.korea-life.016") %></a>.</p>
    <nav class="faq-tabs life-tabs" aria-label="<%= siteText("view.korea-life.017") %>"><% life.topics.forEach(function(topic){ %><a href="#<%= topic.id %>"><%= topic.title %></a><% }) %></nav>
    <div class="life-grid"><% life.topics.forEach(function(topic){ %><article class="life-card" id="<%= topic.id %>">
      <h2><%= topic.title %></h2><p><%= topic.summary %></p><h3><%= siteText("view.korea-life.018") %></h3><ul><% topic.checklist.forEach(function(item){ %><li><%= item %></li><% }) %></ul>
      <a class="official-source" href="<%= topic.sourceUrl %>" target="_blank" rel="noopener noreferrer"><%= siteText("view.korea-life.019") %> <%= topic.sourceName %> ↗</a>
    </article><% }) %></div>
    <aside class="geo-summary"><strong><%= siteText("view.korea-life.020") %></strong> <%= siteText("view.korea-life.021") %></aside>
  </div></section>
</main>
