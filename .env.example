# Sao chép file này thành .env rồi chỉnh sửa

# Domain thật (dùng cho canonical, sitemap, robots và Open Graph). KHÔNG có dấu / ở cuối.
BASE_URL=https://soldream.edu.vn
# SITE_URL vẫn được hỗ trợ như tên biến cũ nếu BASE_URL chưa được đặt.
# SITE_URL=https://soldream.edu.vn

# Ảnh chia sẻ mạng xã hội (Open Graph). Nên up ảnh 1200x630 vào public/img/og-cover.jpg
# OG_IMAGE=https://soldream.edu.vn/img/og-cover.jpg

# Mật khẩu đăng nhập trang admin (/admin). Bắt buộc cấu hình khi NODE_ENV=production.
ADMIN_PASSWORD=
# Khoá bí mật cho session (đặt chuỗi ngẫu nhiên dài)
SESSION_SECRET=

# Phiên Admin tự gia hạn theo hoạt động; hệ thống giới hạn trong khoảng 15–30 phút.
ADMIN_SESSION_MINUTES=30

# Khóa dùng để ẩn danh địa chỉ IP trong bộ chống spam đăng ký tư vấn.
# Có thể dùng một chuỗi ngẫu nhiên dài và khác SESSION_SECRET.
CONTACT_SPAM_SECRET=
# Cổng chạy (mặc định 3000)
PORT=3000

# Gemini API key dùng cho chatbot. Tạo key tại Google AI Studio.
GEMINI_API_KEY=
# Có thể đổi sang model Gemini khác khi cần.
GEMINI_MODEL=gemini-3.6-flash
# Các model dự phòng, cách nhau bằng dấu phẩy. Bot tự chuyển model khi gặp 429/503/timeout.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.6-flash
# Số lượt gọi Gemini tối đa cho mỗi IP trong 10 phút; vượt ngưỡng bot vẫn trả lời bằng dữ liệu nội bộ.
CHAT_RATE_LIMIT=15

# Dung lượng tối đa cho một ảnh/video chèn trong trình soạn thảo Admin (MB).
# Tệp được lưu nguyên bản, không nén lại; mặc định 500MB, giới hạn cho phép 50–1024MB.
MAX_EDITOR_MEDIA_MB=500

# Bot nghiên cứu chỉ tạo dữ liệu chờ duyệt trong Admin, không tự xuất bản.
RESEARCH_BOT_ENABLED=1
RESEARCH_BOT_START_DELAY_MS=60000
RESEARCH_BOT_INTERVAL_MS=43200000
RESEARCH_TIMEOUT_MS=12000
# Thu thập sâu hồ sơ trường: số trang chính thức, dung lượng dữ liệu và thời gian biên tập tối đa.
RESEARCH_UNIVERSITY_MAX_PAGES=42
RESEARCH_UNIVERSITY_SOURCE_CHARS=120000
GEMINI_UNIVERSITY_TIMEOUT_MS=120000
RESEARCH_EDITORIAL_SOURCE_CHARS=90000
# Có thể dùng model riêng cho tác vụ biên tập.
GEMINI_EDITOR_MODEL=gemini-3.5-flash-lite
GEMINI_EDITOR_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.6-flash
# Đường dẫn tuyệt đối hoặc tương đối tới tài liệu hướng dẫn biên soạn cố định (>32k token).
# Để trống nếu chưa có tài liệu; fallback model vẫn hoạt động nhưng explicit cache chưa được bật.
GEMINI_CACHE_DOCUMENT_PATH=D:/sol-dream-education/sol-dream/data/editorial-cache-guide.md
GEMINI_EDITOR_TIMEOUT_MS=60000
GEMINI_CACHE_TTL_SECONDS=7200
GEMINI_FALLBACK_BACKOFF_MS=1000
GEMINI_FALLBACK_MAX_BACKOFF_MS=2000
GEMINI_EDITOR_BATCH_SIZE=80
GEMINI_EDITOR_REQUEST_INTERVAL_MS=4200
RESEARCH_EDITORIAL_START_DELAY_MS=120000
RESEARCH_EDITORIAL_INTERVAL_MS=1800000
# Cho phép tìm ảnh trường bên ngoài khi các trang chính thức không cung cấp ảnh dùng được.
# Ảnh phải khớp tên trường, có giấy phép/nguồn rõ ràng và được tải về máy chủ thay vì hotlink.
EXTERNAL_UNIVERSITY_IMAGE_SEARCH=true
UNIVERSITY_COVER_BACKFILL_LIMIT=100

# Thông báo yêu cầu tư vấn mới tới hotline. Chọn một trong hai cách.
# CONTACT_WEBHOOK_URL=https://example.com/your-secure-webhook
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_HOTLINE_CHAT_ID=

# Gửi email cập nhật đúng chủ đề cho người đã đăng ký nhận thông tin.
# Cách 1: Resend (cần xác minh tên miền gửi).
# RESEND_API_KEY=
# SUBSCRIBER_EMAIL_FROM=SOL DREAM EDUCATION <thongbao@soldream.edu.vn>
# Cách 2: webhook HTTPS của dịch vụ email/automation hiện có.
# SUBSCRIBER_EMAIL_WEBHOOK_URL=https://example.com/your-email-webhook

# Kênh tìm kiếm dự phòng cho nguồn công khai chặn crawler trực tiếp.
# Kết quả luôn bị giới hạn vào đúng hostname chính thức và chỉ vào hàng chờ duyệt.
# OPENAI_API_KEY=
# OPENAI_SEARCH_MODEL=gpt-5-mini
# OPENAI_SEARCH_TIMEOUT_MS=60000

# Chỉ điền khi cố vấn đã đồng ý công bố và thông tin đã được xác minh.
# Không khai báo chứng chỉ ICEF/QEAC nếu cá nhân không thực sự sở hữu.
ADVISOR_NAME=
ADVISOR_JOB_TITLE=Chuyên gia Tư vấn Du học Hàn Quốc
# Nhiều chứng chỉ hoặc URL ngăn cách bằng dấu |
ADVISOR_CREDENTIALS=
ADVISOR_SAME_AS=

# Đường dẫn file database (mặc định db/data.sqlite)
# DATABASE_PATH=./db/data.sqlite
